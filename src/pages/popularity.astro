---
import Layout from "../layouts/Layout.astro";
import { getPopularSlugs, getManifest } from "../lib/data/astro-data.mjs";

const popular = getPopularSlugs(100);
const manifest = getManifest();
---

<Layout title="Popular Baby Names | NameVerse" description="Explore popular baby names ranked by search interest and cultural relevance across major traditions.">
  <main class="nv-page min-h-screen">
    <div class="nv-container nv-section">
      <div class="mx-auto max-w-5xl">
        <h1 class="nv-display text-3xl font-bold text-nv-text sm:text-4xl">Popular Baby Names</h1>
        <p class="mt-2 text-nv-text-secondary">Popularity and discovery tools for parents.</p>

        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            popular.map(({ religion, slug }) => {
              const items = manifest[religion] || [];
              const item = items.find((i) => i.slug === slug);
              if (!item) return null;
              return (
                <a
                  href={`/names/${religion}/${slug}`}
                  class="rounded-xl border border-nv-border bg-white p-4 transition hover:bg-nv-surface-subtle"
                >
                  <div class="text-sm font-bold text-nv-text">{item.name}</div>
                  <div class="mt-1 text-xs text-nv-text-muted">{item.meaning || item.origin || religion}</div>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </main>
</Layout>
