---
import Layout from "../layouts/Layout.astro";
import { getManifest } from "../lib/data/astro-data.mjs";
import { ORIGIN_SLUGS, ORIGIN_LABELS, originSlugFor } from "../lib/data/name-utils.mjs";

const manifest = getManifest();
const origins = ORIGIN_SLUGS.map((slug) => {
  let count = 0;
  for (const rel of ['islamic', 'christian', 'hindu', 'italian']) {
    for (const item of manifest[rel] || []) {
      if (originSlugFor(item.origin) === slug) count++;
    }
  }
  return { slug, label: ORIGIN_LABELS[slug], count };
}).sort((a, b) => b.count - a.count);

const blurb = {
  arabic: 'Quranic, classical and modern names from the Arab world.',
  biblical: 'Names from the Bible across Hebrew, Greek and Latin forms.',
  sanskrit: 'Names from ancient India\'s language of scripture and philosophy.',
  hindu: 'Names rooted in Hindu mythology, deities and traditions.',
  italian: 'Melodic names from Italy, many derived from Latin.',
  persian: 'Names from Iran and the Persian-speaking world.',
  english: 'Names shaped by English language and culture.',
  tamil: 'Names from the Tamil-speaking regions of South Asia.',
  hindi: 'Names from Hindi-speaking North India.',
  bengali: 'Names from Bengali-speaking Bangladesh and Bengal.',
  urdu: 'Names from the Urdu-speaking communities of South Asia.',
};

---

<Layout
  title="Baby Names by Origin — Arabic, Biblical, Sanskrit & More | NameVerse"
  description="Browse baby names by linguistic and cultural origin: Arabic, Biblical, Sanskrit, Persian, Tamil, Hindi and more — with verified meanings on every name."
  canonical="https://nameverse.site/names-by-origin"
>
    <div class="container-page py-10 sm:py-14">
    <div class="mx-auto max-w-5xl">
      <header class="mb-10 text-center">
        <span class="eyebrow">Browse by language</span>
        <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-nv-text sm:text-5xl">Baby Names by Origin</h1>
        <p class="mx-auto mt-3 max-w-2xl text-nv-text-secondary">
          Every name has a birthplace — a language and culture that shaped its sound and meaning.
          Choose an origin below to explore its full collection.
        </p>
      </header>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {origins.map((o) => (
          <a href={`/origins/${o.slug}`} class="card card-hover group flex flex-col gap-2 p-6">
            <div class="flex items-center justify-between gap-2">
              <h2 class="font-display text-xl font-semibold text-nv-text group-hover:text-nv-accent">{o.label}</h2>
              <span class="badge bg-nv-accent-subtle text-nv-accent">{o.count.toLocaleString()}</span>
            </div>
            <p class="text-sm text-nv-text-secondary">{blurb[o.slug] || `Browse ${o.label.toLowerCase()} names.`}</p>
            <span class="mt-auto pt-2 text-sm font-semibold text-nv-accent">Browse {o.label.toLowerCase()} names &rarr;</span>
          </a>
        ))}
      </div>

      <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="seo-heading">
        <h2 id="seo-heading" class="font-display text-2xl font-semibold tracking-tight text-nv-text sm:text-3xl">
          Why origin is a great place to start
        </h2>
        <div class="mt-4 space-y-4 text-sm leading-relaxed text-nv-text-secondary sm:text-base">
          <p>
            Choosing a name by origin can honor your heritage, celebrate a culture you love, or simply
            guide you toward the sounds that appeal to you. Arabic names flow melodically, Sanskrit
            names carry deep philosophy, Italian names feel warm and musical — each origin has its own
            character.
          </p>
          <p>
            Every origin collection on NameVerse is ranked by popularity and linked to full profiles
            with pronunciation, numerology and the story behind each meaning. Once you find an origin
            you love, combine it with gender and religion filters in search to narrow the field.
          </p>
        </div>

        </section>
    </div>
  </div>
</Layout>


