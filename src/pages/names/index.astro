---
import Layout from '../../layouts/Layout.astro';
import NameCard from '../../components/NameCard.astro';
import { getManifest, getPopularSlugs } from '../../lib/data/astro-data.mjs';

const manifest = getManifest();
const religions = [
  { key: 'islamic', label: 'Islamic Names', description: 'Quranic, Arabic & Urdu names', badgeClass: 'bg-islamic-soft text-islamic' },
  { key: 'christian', label: 'Christian Names', description: 'Biblical & modern names', badgeClass: 'bg-christian-soft text-christian' },
  { key: 'hindu', label: 'Hindu Names', description: 'Sanskrit & Vedic names', badgeClass: 'bg-hindu-soft text-hindu' },
  { key: 'italian', label: 'Italian Names', description: 'Classical Italian names', badgeClass: 'bg-italian-soft text-italian' },
].map((r) => ({ ...r, count: manifest[r.key]?.length || 0 }));

const bySlug = {};
for (const key of ['islamic', 'christian', 'hindu', 'italian']) {
  for (const item of manifest[key] || []) bySlug[item.slug] = item;
}
const topNames = getPopularSlugs(24)
  .map(({ slug }) => bySlug[slug])
  .filter(Boolean);
---

<Layout
  title="All Baby Names by Religion — 42,000+ Names & Meanings | NameVerse"
  description="Browse 42,000+ baby names by religion: Islamic, Christian, Hindu & Italian names with verified meanings, origins and lucky numbers. Free A–Z browsing."
>
  <div class="container-page py-10 sm:py-14">
    <div class="mx-auto max-w-5xl">
      <header class="mb-10 text-center">
        <span class="eyebrow">Name directory</span>
        <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-nv-text sm:text-5xl">All Baby Names</h1>
        <p class="mx-auto mt-3 max-w-2xl text-nv-text-secondary">
          Every name in NameVerse, organized by tradition. Pick a religion to browse A–Z, or start
          with the most popular names below.
        </p>
      </header>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {religions.map((rel) => (
          <a href={`/names/${rel.key}/letter/a`} class="card card-hover group flex flex-col gap-2 p-6">
            <span class:list={['badge w-fit', rel.badgeClass]}>{rel.count.toLocaleString()} names</span>
            <h2 class="font-display text-lg font-semibold text-nv-text group-hover:text-nv-accent">{rel.label}</h2>
            <p class="text-sm text-nv-text-secondary">{rel.description}</p>
            <span class="mt-auto pt-2 text-sm font-semibold text-nv-accent">Browse A–Z &rarr;</span>
          </a>
        ))}
      </div>

      <section class="mt-14" aria-labelledby="popular-heading">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
          <h2 id="popular-heading" class="font-display text-2xl font-semibold tracking-tight text-nv-text">
            Most popular names
          </h2>
          <a href="/search" class="btn-ghost">Search all names</a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {topNames.map((item) => <NameCard item={item} />)}
        </div>
      </section>
    </div>
  </div>
</Layout>
