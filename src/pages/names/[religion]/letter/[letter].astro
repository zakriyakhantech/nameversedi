---
import Layout from '../../../../layouts/Layout.astro';
import AlphabetNav from '../../../../components/AlphabetNav.astro';
import NameCard from '../../../../components/NameCard.astro';
import { getManifest, normalizeReligion } from '../../../../lib/data/astro-data.mjs';
import { ALL_RELIGIONS, ALL_LETTERS, lettersFor } from '../../../../lib/data/letter-browser.mjs';

export async function getStaticPaths() {
  const manifest = getManifest();
  const paths = [];
  for (const religion of ALL_RELIGIONS) {
    const available = lettersFor(religion, manifest);
    for (const letter of ALL_LETTERS) {
      if (available.has(letter)) paths.push({ params: { religion, letter } });
    }
  }
  return paths;
}

export const prerender = true;

const { religion, letter } = Astro.params;
const finalReligion = normalizeReligion(religion) || 'islamic';
const siteUrl = 'https://nameverse.site';

const manifest = getManifest();
const availableLetters = lettersFor(finalReligion, manifest);

const names = (manifest[finalReligion] || [])
  .filter((item) => {
    if (!item.name) return false;
    const firstChar = item.name.trim().charAt(0).toLowerCase();
    return letter === '#' ? !/^[a-z]$/.test(firstChar) : firstChar === letter;
  })
  .sort((a, b) => a.name.localeCompare(b.name));

const religionLabel = finalReligion.charAt(0).toUpperCase() + finalReligion.slice(1);
const letterDisplay = letter.toUpperCase();
const letterUrlSegment = letter === '#' ? '%23' : letter;
const canonicalUrl = `${siteUrl}/names/${finalReligion}/letter/${letterUrlSegment}`;

// Religions that also have names for this letter (for the switcher)
const switcherReligions = ALL_RELIGIONS.filter((r) => lettersFor(r, manifest).has(letter));

const boyCount = names.filter((i) => {
  const g = (i.gender || '').toLowerCase();
  const m = g.includes('male') || g.includes('boy') || g.includes('masculin');
  const f = g.includes('female') || g.includes('girl');
  return m && !f;
}).length;
const girlCount = names.filter((i) => {
  const g = (i.gender || '').toLowerCase();
  const f = g.includes('female') || g.includes('girl');
  const m = g.includes('male') || g.includes('boy');
  return f && !m;
}).length;

const nearby = [...'abcdefghijklmnopqrstuvwxyz', '#'];
const nearbyLetters = nearby.filter((l) => l !== letter && lettersFor(finalReligion, manifest).has(l));

---

<Layout
  title={`"${letterDisplay}" ${religionLabel} Baby Names & Meanings (${names.length}) | NameVerse`}
  description={`Browse ${names.length} ${religionLabel} baby names starting with "${letterDisplay}" — verified meanings, origins, gender and lucky numbers. Free A–Z browsing.`}
  canonical={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${religionLabel} Baby Names Starting with "${letterDisplay}"`,
    description: `${names.length} ${religionLabel} baby names beginning with "${letterDisplay}", each with meaning, origin and cultural context.`,
    url: canonicalUrl,
  })} />

  <div class="container-page py-8 sm:py-12">
    <div class="mx-auto max-w-6xl">
      <!-- Breadcrumb -->
      <nav class="mb-6 flex items-center gap-2 text-sm text-nv-text-muted" aria-label="Breadcrumb">
        <a href="/" class="font-medium transition hover:text-nv-accent">Home</a>
        <span>/</span>
        <a href={`/names/${finalReligion}`} class="font-medium transition hover:text-nv-accent">{religionLabel} Names</a>
        <span>/</span>
        <span class="font-medium text-nv-text">Letter {letterDisplay}</span>
      </nav>

      <!-- Hero -->
      <header class="mb-8 text-center">
        <span class="badge bg-nv-accent-subtle text-nv-accent">{names.length} names &bull; {boyCount.toLocaleString()} boys &bull; {girlCount.toLocaleString()} girls</span>
        <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-nv-text sm:text-5xl">
          {religionLabel} Names Starting with &ldquo;{letterDisplay}&rdquo;
        </h1>
        <p class="mx-auto mt-3 max-w-2xl text-nv-text-secondary">
          Authentic {religionLabel} baby names beginning with <strong>{letterDisplay}</strong> —
          with meanings, origins and lucky numbers. Choose from {names.length.toLocaleString()}{' '}
          {religionLabel.toLowerCase()} names starting with this letter, or explore another letter below.
        </p>
      </header>

      <!-- Alphabet nav -->
      <div class="mb-6">
        <AlphabetNav religion={finalReligion} currentLetter={letter} availableLetters={availableLetters} />
      </div>

      <!-- Religion switcher -->
      <div class="mb-10 flex flex-wrap justify-center gap-2">
        {switcherReligions.map((r) => (
          <a
            href={`/names/${r}/letter/${letterUrlSegment}`}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-semibold transition',
              r === finalReligion
                ? 'bg-nv-primary text-white'
                : 'border border-nv-border bg-nv-surface text-nv-text-secondary hover:border-nv-accent/50 hover:text-nv-accent',
            ]}
          >
            {r.charAt(0).toUpperCase() + r.slice(1)}
          </a>
        ))}
      </div>

      <!-- Names grid -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {names.map((item) => <NameCard item={item} />)}
      </div>

      <!-- Nearby letters -->
      {nearbyLetters.length > 0 && (
        <nav class="mt-10 text-center" aria-label="Nearby letters">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.16em] text-nv-text-muted">Explore other letters</p>
          <div class="flex flex-wrap justify-center gap-2">
            {nearbyLetters.slice(0, 10).map((l) => (
              <a href={`/names/${finalReligion}/letter/${l === '#' ? '%23' : l}`} class="grid h-10 w-10 place-items-center rounded-lg border border-nv-border bg-nv-surface text-sm font-bold uppercase text-nv-text-secondary transition hover:border-nv-accent hover:text-nv-accent">
                {l}
              </a>
            ))}
          </div>
        </nav>
      )}

      <!-- SEO copy -->
      <section class="mx-auto mt-14 max-w-3xl" aria-labelledby="letter-seo">
        <h2 id="letter-seo" class="text-center font-display text-2xl font-semibold tracking-tight text-nv-text">
          Why choose a {religionLabel} name beginning with &ldquo;{letterDisplay}&rdquo;?
        </h2>
        <div class="mt-4 space-y-4 text-sm leading-relaxed text-nv-text-secondary sm:text-base">
          <p>
            Names that start with <strong>{letterDisplay}</strong> give your child a strong, clear
            initial that is easy to spell, monogram and remember. In the {religionLabel.toLowerCase()}
            tradition, the sound of a name has always mattered as much as its meaning — which is why
            this letter offers {names.length.toLocaleString()} distinct choices, from classic favorites
            to modern spellings.
          </p>
          <p>
            Each name below links to a full profile with the authentic meaning, linguistic origin,
            pronunciation, lucky number, numerology and spelling variations. Bookmark the names you
            love, then use the popularity comparison tool to weigh your final shortlist.
          </p>
        </div>
      </section>
    </div>
  </div>
</Layout>
