---
import Layout from '../../../layouts/Layout.astro';
import { readNameData, getAllSlugs, normalizeReligion, getManifest } from '../../../lib/data/astro-data.mjs';
import { religionLabel, normalizeGender, genderLabel, slugify, originSlugFor, categorySlugFor, ORIGIN_LABELS } from '../../../lib/data/name-utils.mjs';

export async function getStaticPaths() {
  const slugs = getAllSlugs();
  return slugs.map(({ religion, slug }) => ({
    params: { religion, slug },
  }));
}

export const prerender = true;

const { religion, slug } = Astro.params;
const finalReligion = normalizeReligion(religion);

if (!finalReligion || !slug) return Astro.redirect('/');

const normalizedSlug = String(slug || '').trim().toLowerCase().replace(/\.json$/i, '');
if (!normalizedSlug) return Astro.redirect('/');

const nameData = await readNameData(finalReligion, normalizedSlug);
if (!nameData) return Astro.redirect('/');

const manifest = getManifest();
const religionManifest = manifest[finalReligion] || [];
const knownSlugsMap = new Map();
for (const r of ['islamic', 'christian', 'hindu', 'italian']) {
  for (const item of manifest[r] || []) {
    knownSlugsMap.set(`${r}:${item.slug}`, item);
  }
}

const seo = nameData.seo?.seo || nameData.seo || {};
const seoOuter = nameData.seo || {};
const pageTitle = seo.title || seoOuter.title || `${nameData.name} — ${religionLabel(finalReligion)} Name Meaning | NameVerse`;
const pageDescription = seo.meta_description || seoOuter.meta_description || nameData.short_meaning || nameData.meaning || `Meaning and origin of the name ${nameData.name}`;
const introParagraph = seo.description_paragraph || seoOuter.description_paragraph || '';
const faqData = Array.isArray(seo.faq) ? seo.faq : Array.isArray(seoOuter.faq) ? seoOuter.faq : [];
const canonicalUrl = `https://nameverse.site/names/${finalReligion}/${normalizedSlug}`;
const siteUrl = 'https://nameverse.site';

const relLabel = religionLabel(finalReligion);
const genderKey = normalizeGender(nameData.gender);
const genLabel = genderKey ? genderLabel(nameData.gender) : '';
const origin = nameData.origin || '';
const originSlug = originSlugFor(origin);
const categorySlug = categorySlugFor(nameData.category);
const meaning = nameData.short_meaning || nameData.meaning || '';
const longMeaning = nameData.long_meaning || '';
const pronunciation = nameData.pronunciation?.english || nameData.pronunciation?.ipa || '';
const luckyNumber = nameData.lucky_number ?? nameData.luckyNumber;
const luckyDay = nameData.lucky_day || '';
const luckyColors = Array.isArray(nameData.lucky_colors) ? nameData.lucky_colors : [];
const luckyStone = nameData.lucky_stone || '';
const lifePath = nameData.life_path_number ?? '';
const numerology = nameData.numerology_meaning || '';
const popularityScore = nameData.popularity_score ?? '';
const traits = [
  ...(Array.isArray(nameData.emotional_traits) ? nameData.emotional_traits : []),
  ...(Array.isArray(nameData.hidden_personality_traits) ? nameData.hidden_personality_traits : []),
];
const languages = Array.isArray(nameData.language) ? nameData.language : [];
const rawSimilarNames = Array.isArray(nameData.similar_sounding_names) ? nameData.similar_sounding_names : [];
const variations = Array.isArray(nameData.name_variations) ? nameData.name_variations : [];
const rawRelatedNames = Array.isArray(nameData.related_names) ? nameData.related_names : [];
const regionData = Array.isArray(nameData.popularity_by_region) ? nameData.popularity_by_region : [];

// Resolve links for similar & related names
function resolveNameLink(rawName) {
  const targetSlug = slugify(rawName);
  if (!targetSlug) return null;
  // First check current religion
  if (knownSlugsMap.has(`${finalReligion}:${targetSlug}`)) {
    return { name: rawName, href: `/names/${finalReligion}/${targetSlug}` };
  }
  // Check other religions
  for (const r of ['islamic', 'christian', 'hindu', 'italian']) {
    if (r !== finalReligion && knownSlugsMap.has(`${r}:${targetSlug}`)) {
      return { name: rawName, href: `/names/${r}/${targetSlug}` };
    }
  }
  return { name: rawName, href: null };
}

const resolvedSimilarNames = rawSimilarNames.slice(0, 10).map(resolveNameLink).filter(Boolean);
const resolvedRelatedNames = rawRelatedNames.slice(0, 10).map(resolveNameLink).filter(Boolean);

// Name in other languages
const otherLangs = [
  { key: 'in_arabic', label: 'Arabic', rtl: true },
  { key: 'in_urdu', label: 'Urdu', rtl: true },
  { key: 'in_hindi', label: 'Hindi', rtl: false },
  { key: 'in_pashto', label: 'Pashto', rtl: true },
  { key: 'in_hebrew', label: 'Hebrew', rtl: true },
  { key: 'in_greek', label: 'Greek', rtl: false },
  { key: 'in_latin', label: 'Latin', rtl: false },
  { key: 'in_english', label: 'English', rtl: false },
]
  .map((lang) => ({ ...lang, data: nameData[lang.key] }))
  .filter((lang) => lang.data && lang.data.name);

function cleanText(s) {
  const t = String(s || '').replace(/[?]{2,}/g, ' ').trim();
  return t.includes('\uFFFD') ? '' : t;
}

function headingStyle() {
  return 'font-display text-xl font-semibold tracking-tight text-nv-text sm:text-2xl';
}

const firstLetter = nameData.name.trim().charAt(0).toLowerCase();
const letterSegment = /^[a-z]$/.test(firstLetter) ? firstLetter : '%23';
---

<Layout title={pageTitle} description={pageDescription} canonical={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: pageTitle,
    description: pageDescription,
    url: canonicalUrl,
    mainEntity: {
      '@type': 'Thing',
      name: nameData.name,
      description: meaning,
      additionalType: origin,
    },
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'All Names', item: `${siteUrl}/names` },
      { '@type': 'ListItem', position: 3, name: `${relLabel} Names`, item: `${siteUrl}/names/${finalReligion}` },
      { '@type': 'ListItem', position: 4, name: nameData.name },
    ],
  })} />

  {faqData.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqData.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    })} />
  )}

  <div class="container-page py-8 sm:py-12">
    <div class="mx-auto max-w-5xl space-y-6">
      <!-- Breadcrumb -->
      <nav class="flex flex-wrap items-center gap-2 text-sm text-nv-text-muted" aria-label="Breadcrumb">
        <a href="/" class="font-medium transition hover:text-nv-accent">Home</a>
        <span>/</span>
        <a href="/names" class="font-medium transition hover:text-nv-accent">All Names</a>
        <span>/</span>
        <a href={`/names/${finalReligion}`} class="font-medium transition hover:text-nv-accent">{relLabel} Names</a>
        <span>/</span>
        <a href={`/names/${finalReligion}/letter/${letterSegment}`} class="font-medium transition hover:text-nv-accent">Letter {firstLetter.toUpperCase()}</a>
        <span>/</span>
        <span class="font-medium text-nv-text">{nameData.name}</span>
      </nav>

      <!-- Hero Card -->
      <div class="card p-6 sm:p-8 lg:p-10">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
          <div class="flex-1">
            <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-nv-accent-subtle px-3 py-1 text-xs font-semibold text-nv-accent">
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              {relLabel} Name Meaning &amp; Origin Guide
            </div>
            <h1 class="break-words font-display text-4xl font-bold tracking-tight text-nv-text sm:text-5xl lg:text-6xl">{nameData.name}</h1>
            {meaning && <p class="mt-3 text-base text-nv-text-secondary sm:text-lg">{meaning}</p>}
            {pronunciation && (
              <p class="mt-3 flex items-center gap-2 text-sm text-nv-text-muted">
                <svg class="h-4 w-4 text-nv-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
                <span class="font-semibold text-nv-text">Pronunciation:</span> {pronunciation}
                {nameData.pronunciation?.ipa && <span class="text-nv-text-muted">({nameData.pronunciation.ipa})</span>}
              </p>
            )}
          </div>
          <div class="flex flex-wrap gap-2">
            {genderKey === 'boy' && <a href={`/${finalReligion}-boy-names`} class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700 transition hover:bg-sky-100 dark:bg-sky-950/50 dark:text-sky-300">Boy Name</a>}
            {genderKey === 'girl' && <a href={`/${finalReligion}-girl-names`} class="rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700 transition hover:bg-rose-100 dark:bg-rose-950/50 dark:text-rose-300">Girl Name</a>}
            {genderKey === 'unisex' && <span class="rounded-full bg-purple-50 px-3 py-1 text-xs font-semibold text-purple-700 dark:bg-purple-950/50 dark:text-purple-300">Unisex Name</span>}
            {origin && originSlug && <a href={`/origins/${originSlug}`} class="rounded-full border border-nv-border bg-nv-surface px-3 py-1 text-xs font-semibold text-nv-text-secondary transition hover:border-nv-accent/50 hover:text-nv-accent">{origin} origin</a>}
            {origin && !originSlug && <span class="rounded-full border border-nv-border bg-nv-surface px-3 py-1 text-xs font-semibold text-nv-text-secondary">{origin} origin</span>}
            {popularityScore !== '' && <span class="rounded-full border border-nv-border bg-nv-surface px-3 py-1 text-xs font-semibold text-nv-text-secondary">Popularity {popularityScore}</span>}
          </div>
        </div>

        <!-- Stats Grid (High readability & contrast) -->
        <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
          {meaning && (
            <div class="rounded-2xl border border-nv-border bg-nv-subtle p-4">
              <div class="text-xs font-bold uppercase tracking-wider text-nv-text-muted">Meaning</div>
              <div class="mt-1.5 text-sm font-semibold text-nv-text line-clamp-2">{meaning}</div>
            </div>
          )}
          {origin && (
            <div class="rounded-2xl border border-nv-border bg-nv-subtle p-4">
              <div class="text-xs font-bold uppercase tracking-wider text-nv-text-muted">Origin</div>
              <div class="mt-1.5 text-sm font-semibold text-nv-text">{origin}</div>
            </div>
          )}
          {luckyNumber !== '' && (
            <div class="rounded-2xl border border-nv-border bg-nv-subtle p-4">
              <div class="text-xs font-bold uppercase tracking-wider text-nv-text-muted">Lucky Number</div>
              <div class="mt-1.5 text-2xl font-bold text-nv-text">{luckyNumber}</div>
            </div>
          )}
          {luckyDay && (
            <div class="rounded-2xl border border-nv-border bg-nv-subtle p-4">
              <div class="text-xs font-bold uppercase tracking-wider text-nv-text-muted">Lucky Day</div>
              <div class="mt-1.5 text-sm font-semibold text-nv-text">{luckyDay}</div>
            </div>
          )}
          {luckyStone && (
            <div class="rounded-2xl border border-nv-border bg-nv-subtle p-4">
              <div class="text-xs font-bold uppercase tracking-wider text-nv-text-muted">Lucky Stone</div>
              <div class="mt-1.5 text-sm font-semibold text-nv-text">{luckyStone}</div>
            </div>
          )}
          {lifePath !== '' && (
            <div class="rounded-2xl border border-nv-border bg-nv-subtle p-4">
              <div class="text-xs font-bold uppercase tracking-wider text-nv-text-muted">Life Path</div>
              <div class="mt-1.5 text-2xl font-bold text-nv-text">{lifePath}</div>
            </div>
          )}
          {popularityScore !== '' && (
            <div class="rounded-2xl border border-nv-border bg-nv-subtle p-4">
              <div class="text-xs font-bold uppercase tracking-wider text-nv-text-muted">Popularity Score</div>
              <div class="mt-1.5 text-2xl font-bold text-nv-text">{popularityScore}</div>
            </div>
          )}
          {languages.length > 0 && (
            <div class="rounded-2xl border border-nv-border bg-nv-subtle p-4">
              <div class="text-xs font-bold uppercase tracking-wider text-nv-text-muted">Language</div>
              <div class="mt-1.5 text-sm font-semibold text-nv-text line-clamp-2">{languages.join(', ')}</div>
            </div>
          )}
        </div>

        <!-- Lucky Colors -->
        {luckyColors.length > 0 && (
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <span class="mr-1 text-xs font-bold uppercase tracking-wide text-nv-text-muted">Lucky Colors:</span>
            {luckyColors.map((color) => (
              <span class="rounded-full border border-nv-border bg-nv-surface px-3 py-1 text-xs font-semibold text-nv-text">{color}</span>
            ))}
          </div>
        )}
      </div>

      <!-- Meaning in depth (Unique content first) -->
      {longMeaning ? (
        <section class="card p-6 sm:p-8">
          <h2 class={headingStyle()}>What does {nameData.name} mean?</h2>
          <p class="mt-3 text-base leading-relaxed text-nv-text-secondary">{longMeaning}</p>
        </section>
      ) : cleanText(introParagraph) ? (
        <section class="card p-6 sm:p-8">
          <h2 class={headingStyle()}>About the name {nameData.name}</h2>
          <p class="mt-3 text-base leading-relaxed text-nv-text-secondary">{cleanText(introParagraph)}</p>
        </section>
      ) : null}

      <!-- Transliterations & Other Languages -->
      {otherLangs.length > 0 && (
        <section class="card p-6 sm:p-8">
          <h2 class={headingStyle()}>{nameData.name} in other languages &amp; scripts</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {otherLangs.map((lang) => (
              <div class="rounded-xl border border-nv-border bg-nv-surface p-4">
                <div class="text-xs font-bold uppercase tracking-wide text-nv-text-muted">{lang.label}</div>
                <div class="mt-2 text-xl font-semibold text-nv-text" dir={lang.rtl ? 'rtl' : 'ltr'}>{lang.data.name}</div>
                {cleanText(lang.data.meaning) && <div class="mt-1 text-sm text-nv-text-secondary">{cleanText(lang.data.meaning)}</div>}
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- 2-Column Desktop Grid for Secondary Sections -->
      <div class="grid gap-6 md:grid-cols-2">
        <!-- Pronunciation guide -->
        {nameData.pronunciation && (nameData.pronunciation.english || nameData.pronunciation.biblical || nameData.pronunciation.ipa) && (
          <section class="card p-6 sm:p-8">
            <h2 class={headingStyle()}>How to pronounce {nameData.name}</h2>
            <div class="mt-4 space-y-3">
              {nameData.pronunciation.english && (
                <div class="rounded-xl border border-nv-border bg-nv-surface p-3.5">
                  <div class="text-xs text-nv-text-muted">English pronunciation</div>
                  <div class="mt-1 text-base font-semibold text-nv-text">{nameData.pronunciation.english}</div>
                </div>
              )}
              {nameData.pronunciation.biblical && (
                <div class="rounded-xl border border-nv-border bg-nv-surface p-3.5">
                  <div class="text-xs text-nv-text-muted">Biblical pronunciation</div>
                  <div class="mt-1 text-base font-semibold text-nv-text">{nameData.pronunciation.biblical}</div>
                </div>
              )}
              {nameData.pronunciation.ipa && (
                <div class="rounded-xl border border-nv-border bg-nv-surface p-3.5">
                  <div class="text-xs text-nv-text-muted">IPA notation</div>
                  <div class="mt-1 text-base font-semibold text-nv-text">{nameData.pronunciation.ipa}</div>
                </div>
              )}
            </div>
          </section>
        )}

        <!-- Numerology & Traits -->
        {(numerology || traits.length > 0) && (
          <section class="card p-6 sm:p-8">
            <h2 class={headingStyle()}>Numerology &amp; personality</h2>
            {numerology && (
              <p class="mt-3 text-sm leading-relaxed text-nv-text-secondary sm:text-base">{numerology}</p>
            )}
            {traits.length > 0 && (
              <div class="mt-4">
                <div class="text-xs font-bold uppercase tracking-wide text-nv-text-muted">Associated Traits</div>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {traits.map((trait) => (
                    <span class="rounded-full border border-nv-border bg-nv-surface px-3 py-1 text-xs font-semibold text-nv-text">{trait}</span>
                  ))}
                </div>
              </div>
            )}
          </section>
        )}

        <!-- Spiritual & Cultural Meaning -->
        {(nameData.spiritual_meaning || nameData.cultural_impact) && (
          <section class="card p-6 sm:p-8 md:col-span-2">
            <h2 class={headingStyle()}>Spiritual &amp; cultural context</h2>
            <div class="mt-3 space-y-3 text-base leading-relaxed text-nv-text-secondary">
              {nameData.spiritual_meaning && <p>{nameData.spiritual_meaning}</p>}
              {nameData.cultural_impact && <p>{cleanText(nameData.cultural_impact)}</p>}
            </div>
          </section>
        )}

        <!-- Scriptural References -->
        {(nameData.biblical_reference?.is_biblical || nameData.saint_reference?.is_saint_name || nameData.islamic_reference?.is_quranic) && (
          <section class="card p-6 sm:p-8 md:col-span-2">
            <h2 class={headingStyle()}>Scriptural &amp; traditional roots</h2>
            <div class="mt-3 space-y-3 text-sm leading-relaxed text-nv-text-secondary sm:text-base">
              {nameData.biblical_reference?.origin_scripture && (
                <p><span class="font-semibold text-nv-text">Biblical scripture:</span> {nameData.biblical_reference.origin_scripture} {nameData.biblical_reference.verse_reference && `(${nameData.biblical_reference.verse_reference})`}</p>
              )}
              {nameData.saint_reference?.saint_name && (
                <p><span class="font-semibold text-nv-text">Saint connection:</span> {nameData.saint_reference.saint_name}</p>
              )}
              {nameData.islamic_reference?.surah && (
                <p><span class="font-semibold text-nv-text">Quranic mention:</span> Surah {nameData.islamic_reference.surah}{nameData.islamic_reference.ayah ? `, Ayah ${nameData.islamic_reference.ayah}` : ''}</p>
              )}
            </div>
          </section>
        )}
      </div>

      <!-- Popularity by Region Table -->
      {regionData.length > 0 && (
        <section class="card p-6 sm:p-8">
          <h2 class={headingStyle()}>Popularity of {nameData.name} by region</h2>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-nv-border text-nv-text-muted">
                  <th class="pb-2 font-semibold">Region</th>
                  <th class="pb-2 font-semibold">Country</th>
                  <th class="pb-2 font-semibold">Score</th>
                  <th class="pb-2 font-semibold">Year</th>
                </tr>
              </thead>
              <tbody class="text-nv-text-secondary">
                {regionData.map((item) => (
                  <tr class="border-b border-nv-border/60">
                    <td class="py-2 font-medium text-nv-text">{item.region}</td>
                    <td class="py-2">{item.country_code || '—'}</td>
                    <td class="py-2">{item.score ?? '—'}</td>
                    <td class="py-2">{item.year ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <!-- Name Variations -->
      {variations.length > 0 && (
        <section class="card p-6 sm:p-8">
          <h2 class={headingStyle()}>Spelling variations of {nameData.name}</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {variations.map((v) => (
              <span class="rounded-full border border-nv-border bg-nv-surface px-4 py-2 text-sm font-semibold text-nv-text">{v}</span>
            ))}
          </div>
        </section>
      )}

      <!-- Related & Similar Names (Validated links) -->
      {(resolvedSimilarNames.length > 0 || resolvedRelatedNames.length > 0) && (
        <section class="card p-6 sm:p-8">
          <h2 class={headingStyle()}>Names similar to {nameData.name}</h2>
          <div class="mt-4 space-y-4">
            {resolvedSimilarNames.length > 0 && (
              <div>
                <h3 class="text-xs font-bold uppercase tracking-wide text-nv-text-muted">Similar sounding names</h3>
                <div class="mt-2 flex flex-wrap gap-2">
                  {resolvedSimilarNames.map((s) => s.href ? (
                    <a href={s.href} class="rounded-full border border-nv-border bg-nv-surface px-3.5 py-1.5 text-sm font-semibold text-nv-accent transition hover:bg-nv-accent-subtle">{s.name}</a>
                  ) : (
                    <span class="rounded-full border border-nv-border bg-nv-surface px-3.5 py-1.5 text-sm font-semibold text-nv-text-secondary">{s.name}</span>
                  ))}
                </div>
              </div>
            )}
            {resolvedRelatedNames.length > 0 && (
              <div>
                <h3 class="text-xs font-bold uppercase tracking-wide text-nv-text-muted">Related names</h3>
                <div class="mt-2 flex flex-wrap gap-2">
                  {resolvedRelatedNames.map((s) => s.href ? (
                    <a href={s.href} class="rounded-full border border-nv-border bg-nv-surface px-3.5 py-1.5 text-sm font-semibold text-nv-accent transition hover:bg-nv-accent-subtle">{s.name}</a>
                  ) : (
                    <span class="rounded-full border border-nv-border bg-nv-surface px-3.5 py-1.5 text-sm font-semibold text-nv-text-secondary">{s.name}</span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- FAQ -->
      {faqData.length > 0 && (
        <section class="card p-6 sm:p-8">
          <h2 class={headingStyle()}>Frequently asked questions about {nameData.name}</h2>
          <div class="mt-4 space-y-3">
            {faqData.map((item) => (
              <details class="group rounded-2xl border border-nv-border bg-nv-surface transition hover:border-nv-accent/50">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 text-base font-semibold text-nv-text transition-colors hover:text-nv-accent">
                  <span class="flex-1">{item.q}</span>
                  <svg class="h-5 w-5 shrink-0 text-nv-text-muted transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-5 pb-5 text-base leading-relaxed text-nv-text-secondary">{item.a}</div>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- Cross-links & Sibling Navigation -->
      <div class="flex flex-wrap justify-center gap-2 pt-4">
        <a href={`/names/${finalReligion}/letter/${letterSegment}`} class="btn-ghost">{relLabel} names starting with {firstLetter.toUpperCase()}</a>
        <a href={`/names/${finalReligion}`} class="btn-ghost">All {relLabel.toLowerCase()} names</a>
        {genderKey && <a href={`/${finalReligion}-${genderKey === 'boy' ? 'boy' : 'girl'}-names`} class="btn-ghost">{relLabel} {genderKey === 'boy' ? 'Boy' : 'Girl'} names</a>}
        {originSlug && <a href={`/origins/${originSlug}`} class="btn-ghost">{ORIGIN_LABELS[originSlug] || origin} names</a>}
        <a href="/search" class="btn-ghost">Search all names</a>
      </div>
    </div>
  </div>
</Layout>

