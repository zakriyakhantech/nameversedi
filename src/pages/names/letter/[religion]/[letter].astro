---
import Layout from "../../../../layouts/Layout.astro";
import { readNameData, getAllSlugs, normalizeReligion } from "../../../../lib/data/astro-data.mjs";

export async function getStaticPaths() {
  const religions = ['islamic', 'christian', 'hindu'];
  const letters = 'abcdefghijklmnopqrstuvwxyz#'.split('');
  const paths = [];
  
  for (const religion of religions) {
    const slugs = getAllSlugs().filter(s => s.religion === religion);
    const availableLetters = new Set();
    
    for (const { slug } of slugs) {
      const data = await readNameData(religion, slug);
      if (data?.name) {
        const firstChar = data.name.trim().charAt(0).toLowerCase();
        if (/^[a-z]$/.test(firstChar)) {
          availableLetters.add(firstChar);
        } else {
          availableLetters.add('#');
        }
      }
    }
    
    for (const letter of letters) {
      if (availableLetters.has(letter)) {
        paths.push({ params: { religion, letter } });
      }
    }
  }
  
  return paths;
}

export const prerender = true;

const { religion, letter } = Astro.params;
const finalReligion = normalizeReligion(religion) || 'islamic';
const siteUrl = "https://nameverse.site";

const allSlugs = getAllSlugs().filter(s => s.religion === finalReligion);
const names = [];
for (const { slug } of allSlugs) {
  const data = await readNameData(finalReligion, slug);
  if (data?.name) {
    const firstChar = data.name.trim().charAt(0).toLowerCase();
    if (letter === '#' ? !/^[a-z]$/.test(firstChar) : firstChar === letter) {
      names.push({
        name: data.name,
        slug,
        short_meaning: data.short_meaning || data.meaning || '',
        origin: data.origin || '',
        gender: data.gender || ''
      });
    }
  }
}

names.sort((a, b) => a.name.localeCompare(b.name));

const religionLabel = finalReligion.charAt(0).toUpperCase() + finalReligion.slice(1);
const gradientClass = finalReligion === 'islamic' ? 'from-emerald-600 via-teal-600 to-green-700' : 
                     finalReligion === 'christian' ? 'from-blue-600 via-indigo-600 to-purple-700' : 
                     'from-orange-500 via-amber-500 to-yellow-600';

const alphabet = 'abcdefghijklmnopqrstuvwxyz#'.split('');
---

<Layout 
  title={`${religionLabel} Baby Names Starting with "${letter.toUpperCase()}" | NameVerse`}
  description={`Discover authentic ${religionLabel} baby names beginning with "${letter}". Each name includes meaning, origin, gender, and lucky number.`}
  canonical={`${siteUrl}/names/${finalReligion}/letter/${letter}`}
>
  <main class="nv-page min-h-screen">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: `${religionLabel} Baby Names Starting with "${letter.toUpperCase()}"`,
      description: `A curated collection of ${religionLabel} baby names beginning with "${letter}", each with authentic meanings, origins, and cultural significance.`,
      url: `${siteUrl}/names/${finalReligion}/letter/${letter}`
    })} />

    <!-- Hero -->
    <section class={`relative py-16 px-4 bg-gradient-to-r ${gradientClass} text-white overflow-hidden`}>
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.4)_1px,transparent_0)] bg-[size:24px_24px]"></div>
      <div class="absolute top-0 right-0 w-80 h-80 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/3 blur-3xl"></div>
      <div class="max-w-7xl mx-auto text-center relative z-10">
        <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm px-5 py-2 rounded-full text-sm font-semibold mb-6 border border-white/30">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          <span>{names.length} {religionLabel} Names Found</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-extrabold mb-4 leading-tight tracking-tight">
          {religionLabel} Names Starting with &ldquo;{letter}&rdquo;
        </h1>
        <p class="text-base md:text-lg text-white/85 max-w-2xl mx-auto mb-6 leading-relaxed">
          Discover authentic {religionLabel} baby names beginning with <strong>{letter}</strong> — complete with meanings, origins, and lucky numbers.
        </p>
      </div>
    </section>

    <!-- Breadcrumb -->
    <nav class="max-w-7xl mx-auto px-4 py-4" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-500">
        <li><a href="/" class="text-blue-600 hover:text-blue-800 font-medium transition-colors">Home</a></li>
        <li>/</li>
        <li><a href={`/names/${finalReligion}/letter/a/1`} class="text-blue-600 hover:text-blue-800 font-medium transition-colors">{religionLabel} Names</a></li>
        <li>/</li>
        <li class="text-slate-700 font-semibold">Letter {letter.toUpperCase()}</li>
      </ol>
    </nav>

    <!-- Alphabet Nav -->
    <div class="max-w-7xl mx-auto px-4 mb-8">
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-3 text-center">Browse by Letter</p>
        <div class="flex flex-wrap justify-center gap-1.5">
          {alphabet.map((l) => (
            <a
              key={l}
              href={`/names/${finalReligion}/letter/${l}`}
              aria-label={`${religionLabel} names starting with ${l.toUpperCase()}`}
              class={`w-9 h-9 flex items-center justify-center rounded-lg text-sm font-bold transition-all duration-200 ${
                l === letter
                  ? 'bg-blue-600 text-white shadow-md shadow-blue-200 scale-110'
                  : 'bg-slate-50 text-slate-600 hover:bg-blue-50 hover:text-blue-700 border border-slate-200 hover:border-blue-300'
              }`}
            >
              {l.toUpperCase()}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Religion Switcher -->
    <div class="max-w-7xl mx-auto px-4 mb-8">
      <div class="flex flex-wrap justify-center gap-3">
        {['islamic', 'christian', 'hindu'].map((r) => (
          <a
            key={r}
            href={`/names/${r}/letter/${letter}`}
            class={`px-5 py-2 rounded-full text-sm font-semibold transition-all border ${
              r === finalReligion
                ? 'bg-blue-600 text-white border-blue-600 shadow-md'
                : 'bg-white text-slate-600 border-slate-200 hover:border-blue-300 hover:text-blue-700'
            }`}
          >
            {r.charAt(0).toUpperCase() + r.slice(1)}
          </a>
        ))}
      </div>
    </div>

    <!-- Names Grid -->
    <section class="max-w-7xl mx-auto px-4 pb-16" aria-label={`${religionLabel} names starting with ${letter}`}>
      {names.length === 0 ? (
        <div class="text-center py-20 bg-white rounded-3xl shadow-sm border border-slate-200">
          <div class="text-6xl mb-4">🔍</div>
          <h2 class="text-2xl font-bold text-slate-900 mb-3">No Names Found</h2>
          <p class="text-slate-500 mb-6 max-w-md mx-auto">
            No {religionLabel} names starting with &ldquo;{letter}&rdquo; were found. Try browsing another letter or religion.
          </p>
          <a href={`/names/${finalReligion}/letter/a`} class="inline-flex items-center gap-2 bg-blue-600 text-white px-6 py-3 rounded-xl hover:bg-blue-700 transition-colors font-semibold">
            Browse All {religionLabel} Names
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {names.map((nameItem) => (
            <a
              key={nameItem.slug}
              href={`/names/${finalReligion}/${nameItem.slug}`}
              class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-5 border border-slate-200 hover:border-blue-300 group hover:-translate-y-1 block"
            >
              <div class="flex items-start justify-between mb-3">
                <div class="flex-1 min-w-0">
                  <h3 class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors truncate">
                    {nameItem.name || 'Unknown'}
                  </h3>
                  {nameItem.gender && (
                    <span class={`inline-block text-xs px-2 py-0.5 rounded-full font-medium mt-1.5 ${
                      nameItem.gender.toLowerCase() === 'boy' || nameItem.gender.toLowerCase() === 'male'
                        ? 'bg-blue-50 text-blue-600'
                        : 'bg-pink-50 text-pink-600'
                    }`}>
                      {nameItem.gender}
                    </span>
                  )}
                </div>
                <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0 ml-2">
                  <span class="text-blue-600 font-bold text-sm">{nameItem.name.charAt(0)}</span>
                </div>
              </div>

              <p class="text-blue-700 font-semibold text-sm mb-3 line-clamp-2 leading-snug">
                &ldquo;{nameItem.short_meaning || 'No meaning available'}&rdquo;
              </p>

              <div class="space-y-1.5 text-xs text-slate-500 border-t border-slate-100 pt-3">
                <div class="flex items-center justify-between">
                  <span class="font-medium text-slate-600">Origin</span>
                  <span class="text-right">{nameItem.origin || 'Unknown'}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- FAQ Section -->
    <section class="max-w-4xl mx-auto px-4 pb-20">
      <div class="text-center mb-10">
        <span class="inline-flex items-center gap-2 bg-blue-100 text-blue-700 text-sm font-semibold px-4 py-2 rounded-full mb-4">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Frequently Asked Questions
        </span>
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900">
          About {religionLabel} Names Starting with &ldquo;{letter}&rdquo;
        </h2>
      </div>
      <div class="space-y-4">
        <details class="group bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left font-semibold text-slate-900 hover:text-blue-700 transition-colors list-none">
            <span class="pr-4">What are the most popular {religionLabel} baby names starting with &ldquo;{letter}&rdquo;?</span>
            <span class="flex-shrink-0 w-7 h-7 bg-blue-50 rounded-full flex items-center justify-center text-blue-600 group-open:rotate-180 transition-transform text-lg font-light">⌄</span>
          </summary>
          <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
            NameVerse features {names.length}+ {religionLabel} baby names beginning with &ldquo;{letter}&rdquo;. Each name comes with its authentic meaning, cultural origin, gender classification, and lucky number.
          </div>
        </details>
        <details class="group bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left font-semibold text-slate-900 hover:text-blue-700 transition-colors list-none">
            <span class="pr-4">What do {religionLabel} names starting with &ldquo;{letter}&rdquo; mean?</span>
            <span class="flex-shrink-0 w-7 h-7 bg-blue-50 rounded-full flex items-center justify-center text-blue-600 group-open:rotate-180 transition-transform text-lg font-light">⌄</span>
          </summary>
          <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
            {religionLabel} names beginning with &ldquo;{letter}&rdquo; carry rich cultural and spiritual meanings. Each name on NameVerse includes a detailed meaning explanation, helping parents choose a name with a beautiful and significant meaning.
          </div>
        </details>
        <details class="group bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left font-semibold text-slate-900 hover:text-blue-700 transition-colors list-none">
            <span class="pr-4">Are {religionLabel} names starting with &ldquo;{letter}&rdquo; suitable for boys or girls?</span>
            <span class="flex-shrink-0 w-7 h-7 bg-blue-50 rounded-full flex items-center justify-center text-blue-600 group-open:rotate-180 transition-transform text-lg font-light">⌄</span>
          </summary>
          <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
            {religionLabel} names starting with &ldquo;{letter}&rdquo; include both boy names, girl names, and some unisex options. On each name card, you can find the gender classification.
          </div>
        </details>
        <details class="group bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left font-semibold text-slate-900 hover:text-blue-700 transition-colors list-none">
            <span class="pr-4">How do I find the origin of a {religionLabel} name starting with &ldquo;{letter}&rdquo;?</span>
            <span class="flex-shrink-0 w-7 h-7 bg-blue-50 rounded-full flex items-center justify-center text-blue-600 group-open:rotate-180 transition-transform text-lg font-light">⌄</span>
          </summary>
          <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
            Every name on NameVerse includes its origin — whether Arabic, Persian, Urdu, Sanskrit, Hebrew, Latin, or Greek. Simply click on any {religionLabel} name starting with &ldquo;{letter}&rdquo; to access its full profile.
          </div>
        </details>
      </div>
    </section>

    <!-- SEO Text Block -->
    <section class="max-w-4xl mx-auto px-4 pb-20">
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
        <h2 class="text-xl font-bold text-slate-900 mb-4">
          Find the Perfect {religionLabel} Baby Name Starting with &ldquo;{letter}&rdquo;
        </h2>
        <p class="text-slate-600 text-sm leading-relaxed mb-3">
          Choosing a baby name is one of the most meaningful decisions a parent can make. NameVerse provides a comprehensive, curated database of {religionLabel} names starting with &ldquo;{letter}&rdquo;, each with its authentic meaning, cultural origin, and spiritual significance.
        </p>
        <p class="text-slate-600 text-sm leading-relaxed">
          Browse other letters or switch between Islamic, Hindu, and Christian name collections to find the name that best represents your heritage and values.
        </p>
      </div>
    </section>
  </main>
</Layout>
