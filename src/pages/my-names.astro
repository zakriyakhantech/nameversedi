---
import Layout from "../layouts/Layout.astro";
---

<Layout title="My Saved Names | NameVerse" description="Your personal shortlist of baby names." noindex={true}>
  <div class="container-page py-10 sm:py-14">
    <div class="mx-auto max-w-3xl">
      <h1 class="font-display text-3xl font-bold text-nv-text sm:text-4xl">My Saved Names</h1>
      <p class="mt-4 text-nv-text-secondary">Your personal shortlist of baby names.</p>
      <div class="mt-6 rounded-2xl border border-nv-border bg-nv-surface p-6">
        <p class="text-sm text-nv-text-muted">This feature is under development. Browse <a href="/names" class="font-semibold text-nv-accent hover:underline">all names</a> to explore baby names across all traditions.</p>
      </div>
    </div>
  </div>
</Layout>
