---
import Layout from "../layouts/Layout.astro";
---

<Layout title="My Saved Names | NameVerse" description="Your personal shortlist of baby names.">
  <main class="nv-page min-h-screen">
    <div class="nv-container nv-section">
      <div class="mx-auto max-w-3xl">
        <h1 class="nv-display text-3xl font-bold text-nv-text sm:text-4xl">My Saved Names</h1>
        <p class="mt-4 text-nv-text-secondary">Your personal shortlist of baby names. Coming soon.</p>
        <div class="mt-6 rounded-2xl border border-nv-border bg-white p-6">
          <p class="text-sm text-nv-text-muted">This feature is under development. Browse <a href="/names" class="text-[color:var(--nv-accent)] underline">all names</a> to start building your shortlist.</p>
        </div>
      </div>
    </div>
  </main>
</Layout>
