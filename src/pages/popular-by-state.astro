---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Popular Baby Names by State | NameVerse" description="Explore baby name popularity trends across US states.">
  <main class="nv-page min-h-screen">
    <div class="nv-container nv-section">
      <div class="mx-auto max-w-3xl">
        <h1 class="nv-display text-3xl font-bold text-nv-text sm:text-4xl">Popular Baby Names by State</h1>
        <p class="mt-4 text-nv-text-secondary">Explore baby name popularity trends across US states. Coming soon.</p>
        <div class="mt-6 rounded-2xl border border-nv-border bg-white p-6">
          <p class="text-sm text-nv-text-muted">This page is under development. In the meantime, browse our <a href="/names" class="text-[color:var(--nv-accent)] underline">full names directory</a>.</p>
        </div>
      </div>
    </div>
  </main>
</Layout>
