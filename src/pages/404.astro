---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | NameVerse" description="The page you are looking for does not exist or has moved." noindex={true}>
  <div class="container-page py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <span class="badge bg-nv-accent-subtle text-nv-accent">404 Error</span>
      <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-nv-text sm:text-5xl">Page Not Found</h1>
      <p class="mt-4 text-base leading-relaxed text-nv-text-secondary sm:text-lg">
        The baby name, guide or page you are looking for might have been moved, renamed or does not exist.
      </p>

      <!-- Quick Search Bar -->
      <form action="/search" method="get" class="mt-8">
        <div class="flex gap-2">
          <input
            type="search"
            name="q"
            placeholder="Search 42,000+ baby names…"
            aria-label="Search baby names"
            class="input flex-1"
            autocomplete="off"
          />
          <button type="submit" class="btn-primary shrink-0">Search</button>
        </div>
      </form>

      <!-- Recovery Navigation Links -->
      <div class="mt-10 rounded-2xl border border-nv-border bg-nv-surface p-6 sm:p-8">
        <h2 class="text-xs font-bold uppercase tracking-wider text-nv-text-muted">Explore popular sections</h2>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
          <a href="/names/islamic" class="rounded-xl border border-nv-border bg-nv-surface-subtle p-3 text-center transition hover:border-nv-accent hover:text-nv-accent">
            <span class="block text-sm font-semibold text-nv-text">Islamic Names</span>
            <span class="text-xs text-nv-text-muted">16k+ names</span>
          </a>
          <a href="/names/christian" class="rounded-xl border border-nv-border bg-nv-surface-subtle p-3 text-center transition hover:border-nv-accent hover:text-nv-accent">
            <span class="block text-sm font-semibold text-nv-text">Christian Names</span>
            <span class="text-xs text-nv-text-muted">10k+ names</span>
          </a>
          <a href="/names/hindu" class="rounded-xl border border-nv-border bg-nv-surface-subtle p-3 text-center transition hover:border-nv-accent hover:text-nv-accent">
            <span class="block text-sm font-semibold text-nv-text">Hindu Names</span>
            <span class="text-xs text-nv-text-muted">14k+ names</span>
          </a>
          <a href="/names/italian" class="rounded-xl border border-nv-border bg-nv-surface-subtle p-3 text-center transition hover:border-nv-accent hover:text-nv-accent">
            <span class="block text-sm font-semibold text-nv-text">Italian Names</span>
            <span class="text-xs text-nv-text-muted">1.5k+ names</span>
          </a>
        </div>

        <div class="mt-6 flex flex-wrap justify-center gap-2">
          <a href="/" class="btn-primary">Back to Homepage</a>
          <a href="/trending-names" class="btn-ghost">Trending Names</a>
          <a href="/unique-names" class="btn-ghost">Unique Names</a>
          <a href="/popularity" class="btn-ghost">Popularity Tool</a>
        </div>
      </div>
    </div>
  </div>
</Layout>
