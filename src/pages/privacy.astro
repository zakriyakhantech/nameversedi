---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Privacy Policy | NameVerse" description="NameVerse privacy policy and data handling practices.">
  <main class="nv-page min-h-screen">
    <div class="nv-container nv-section">
      <div class="mx-auto max-w-3xl">
        <h1 class="nv-display text-3xl font-bold text-nv-text sm:text-4xl">Privacy Policy</h1>
        <p class="mt-4 text-nv-text-secondary">Your privacy is important to us.</p>
        <div class="mt-6 space-y-4 rounded-2xl border border-nv-border bg-white p-6">
          <p class="text-sm text-nv-text-secondary">NameVerse is committed to protecting your privacy. This policy explains how we handle data when you use our site.</p>
          <p class="text-sm text-nv-text-secondary">We do not sell personal data. We may use analytics and advertising partners that collect anonymous usage data to improve the site experience.</p>
          <p class="text-sm text-nv-text-secondary">For questions, contact us at privacy@nameverse.site.</p>
        </div>
      </div>
    </div>
  </main>
</Layout>
