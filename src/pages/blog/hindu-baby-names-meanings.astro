---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Hindu Baby Names with Deep Meanings | NameVerse" description="Sanskrit and Vedic names that carry spiritual significance and cultural heritage." noindex={true}>
  <div class="container-page py-10 sm:py-14">
    <div class="mx-auto max-w-3xl">
      <a href="/blog" class="text-sm font-semibold text-nv-accent hover:underline">&larr; Back to Blog</a>
      <h1 class="font-display mt-4 text-3xl font-bold text-nv-text sm:text-4xl">Hindu Baby Names with Deep Meanings</h1>
      <p class="mt-4 text-nv-text-secondary">Sanskrit and Vedic names that carry spiritual significance and cultural heritage.</p>
      <div class="mt-6 rounded-2xl border border-nv-border bg-nv-surface p-6">
        <p class="text-sm text-nv-text-muted">Full article coming soon. Browse our <a href="/names/hindu" class="font-semibold text-nv-accent hover:underline">Hindu names directory</a> for meanings and origins.</p>
      </div>
    </div>
  </div>
</Layout>
