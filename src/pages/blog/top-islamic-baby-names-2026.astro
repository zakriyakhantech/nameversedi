---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Top Islamic Baby Names for 2026 | NameVerse" description="Explore the most searched Muslim baby names this year with meanings and origins.">
  <main class="nv-page min-h-screen">
    <div class="nv-container nv-section">
      <div class="mx-auto max-w-3xl">
        <a href="/blog" class="text-sm font-semibold text-[color:var(--nv-accent)] hover:underline">← Back to Blog</a>
        <h1 class="nv-display mt-4 text-3xl font-bold text-nv-text sm:text-4xl">Top Islamic Baby Names for 2026</h1>
        <p class="mt-4 text-nv-text-secondary">Explore the most searched Muslim baby names this year with meanings and origins.</p>
        <div class="mt-6 rounded-2xl border border-nv-border bg-white p-6">
          <p class="text-sm text-nv-text-muted">Full article coming soon. Browse our <a href="/names/islamic/1" class="text-[color:var(--nv-accent)] underline">Islamic names directory</a> for meanings and origins.</p>
        </div>
      </div>
    </div>
  </main>
</Layout>
