---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Expert Naming Guide | NameVerse" description="Decision framework and expert guidance for choosing the perfect baby name." noindex={true}>
  <div class="container-page py-10 sm:py-14">
    <div class="mx-auto max-w-3xl">
      <h1 class="font-display text-3xl font-bold text-nv-text sm:text-4xl">Expert Naming Guide</h1>
      <p class="mt-4 text-nv-text-secondary">A decision framework for choosing the perfect baby name.</p>
      <div class="mt-6 rounded-2xl border border-nv-border bg-nv-surface p-6">
        <p class="text-sm text-nv-text-muted">This guide is under development. Browse <a href="/names" class="font-semibold text-nv-accent hover:underline">all names</a> to start your research.</p>
      </div>
    </div>
  </div>
</Layout>
