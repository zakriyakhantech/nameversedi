---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Expert Naming Guide | NameVerse" description="Decision framework and expert guidance for choosing the perfect baby name.">
  <main class="nv-page min-h-screen">
    <div class="nv-container nv-section">
      <div class="mx-auto max-w-3xl">
        <h1 class="nv-display text-3xl font-bold text-nv-text sm:text-4xl">Expert Naming Guide</h1>
        <p class="mt-4 text-nv-text-secondary">A decision framework for choosing the perfect baby name. Coming soon.</p>
        <div class="mt-6 rounded-2xl border border-nv-border bg-white p-6">
          <p class="text-sm text-nv-text-muted">This guide is under development. Browse <a href="/names" class="text-[color:var(--nv-accent)] underline">all names</a> to start your research.</p>
        </div>
      </div>
    </div>
  </main>
</Layout>
