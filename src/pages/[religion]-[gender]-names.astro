---
import Layout from '../layouts/Layout.astro';
import NameCard from '../components/NameCard.astro';
import { getManifest } from '../lib/data/astro-data.mjs';

export async function getStaticPaths() {
  const religions = ['islamic', 'christian', 'hindu', 'italian'];
  const genders = ['boy', 'girl'];
  const paths = [];
  for (const religion of religions) {
    for (const gender of genders) {
      paths.push({ params: { religion, gender } });
    }
  }
  return paths;
}

const { religion, gender } = Astro.params;

const validReligions = ['islamic', 'christian', 'hindu', 'italian'];
const validGenders = ['boy', 'girl'];

if (!validReligions.includes(religion) || !validGenders.includes(gender)) {
  return Astro.redirect('/names');
}

const manifest = getManifest();
const items = (manifest[religion] || [])
  .filter((item) => item.gender && item.gender.toLowerCase().includes(gender))
  .slice(0, 200);

const religionLabel = religion.charAt(0).toUpperCase() + religion.slice(1);
const genderLabel = gender.charAt(0).toUpperCase() + gender.slice(1);
---

<Layout
  title={`${genderLabel}s' ${religionLabel} Baby Names & Meanings | NameVerse`}
  description={`Browse ${items.length}+ ${religionLabel.toLowerCase()} ${gender} baby names with verified meanings, origins and lucky numbers. Free, updated for 2026.`}
>
  <div class="container-page py-10 sm:py-14">
    <div class="mx-auto max-w-6xl">
      <header class="mb-8">
        <span class="eyebrow">{religionLabel} &bull; {genderLabel} names</span>
        <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-nv-text sm:text-4xl">
          {religionLabel} {genderLabel} Names
        </h1>
        <p class="mt-3 max-w-2xl text-nv-text-secondary">
          Hand-picked {gender} names from the {religionLabel.toLowerCase()} tradition, each with a
          verified meaning and origin.
        </p>
      </header>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {items.map((item) => <NameCard item={item} />)}
      </div>

      <p class="mt-10 text-center text-sm text-nv-text-muted">
        Looking for more?
        <a href={`/names/${religion}/letter/a`} class="font-semibold text-nv-accent hover:underline">
          Browse all {religionLabel.toLowerCase()} names A–Z
        </a>
      </p>
    </div>
  </div>
</Layout>
