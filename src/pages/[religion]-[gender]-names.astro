---
import Layout from "../layouts/Layout.astro";
import { getManifest } from "../lib/data/astro-data.mjs";

export async function getStaticPaths() {
  const religions = ['islamic', 'christian', 'hindu', 'italian'];
  const genders = ['boy', 'girl'];
  const paths = [];
  for (const religion of religions) {
    for (const gender of genders) {
      paths.push({ params: { religion, gender } });
    }
  }
  return paths;
}

const { religion, gender } = Astro.params;

const validReligions = ['islamic', 'christian', 'hindu', 'italian'];
const validGenders = ['boy', 'girl'];

if (!validReligions.includes(religion) || !validGenders.includes(gender)) {
  return Astro.redirect('/names');
}

const manifest = getManifest();
const items = (manifest[religion] || [])
  .filter((item) => item.gender && item.gender.toLowerCase().includes(gender))
  .slice(0, 200);

const religionLabel = religion.charAt(0).toUpperCase() + religion.slice(1);
---

<Layout title={`${religionLabel} ${gender.charAt(0).toUpperCase() + gender.slice(1)} Names | NameVerse`} description={`Browse ${gender} ${religion} names with meanings and origins.`}>
  <main class="nv-page min-h-screen">
    <div class="nv-container nv-section">
      <div class="mx-auto max-w-5xl">
        <h1 class="nv-display text-3xl font-bold text-nv-text sm:text-4xl">{religionLabel} {gender.charAt(0).toUpperCase() + gender.slice(1)} Names</h1>
        <p class="mt-2 text-nv-text-secondary">Browse {gender} {religion} names with meanings and origins.</p>

        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            items.map((item) => (
              <a
                href={`/names/${religion}/${item.slug}`}
                class="rounded-xl border border-nv-border bg-white p-4 transition hover:bg-nv-surface-subtle"
              >
                <div class="text-sm font-bold text-nv-text">{item.name}</div>
                <div class="mt-1 text-xs text-nv-text-muted">{item.meaning || item.origin || ''}</div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </main>
</Layout>
