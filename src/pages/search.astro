---
import Layout from '../layouts/Layout.astro';

const { q, religion, gender, origin, category } = Astro.url.searchParams;
const query = (q || '').trim();

const religions = ['islamic', 'christian', 'hindu', 'italian'];
const religionLabels = { christian: 'Christian', hindu: 'Hindu', islamic: 'Islamic', italian: 'Italian' };
const genderLabels = { boy: 'Boy', girl: 'Girl', unisex: 'Unisex' };
const originLabels = {
  arabic: 'Arabic', biblical: 'Biblical', sanskrit: 'Sanskrit', hindu: 'Hindu',
  italian: 'Italian', persian: 'Persian', english: 'English', tamil: 'Tamil',
  hindi: 'Hindi', bengali: 'Bengali', urdu: 'Urdu',
};
const categoryLabels = { islamic: 'Islamic', hindu: 'Hindu', biblical: 'Biblical', saint: 'Saint', virtue: 'Virtue', italian: 'Italian' };

const activeFilters = [];
if (religion && religionLabels[religion]) activeFilters.push(`${religionLabels[religion]} names`);
if (gender && genderLabels[gender]) activeFilters.push(`${genderLabels[gender]} names`);
if (origin && originLabels[origin]) activeFilters.push(`${originLabels[origin]} origin`);
if (category && categoryLabels[category]) activeFilters.push(`${categoryLabels[category]} category`);

const pageTitle = query
  ? `"${query}" ${activeFilters.length ? '— ' + activeFilters.join(', ') : ''} Baby Name Results | NameVerse`
  : activeFilters.length
    ? `${activeFilters.join(', ')} — Baby Names & Meanings | NameVerse`
    : 'Search 42,000+ Baby Names by Meaning, Origin, Religion & Gender | NameVerse';

const pageDescription = query
  ? `Search results for "${query}"${activeFilters.length ? ` in ${activeFilters.join(', ')}` : ''} — meanings, origins, gender and popularity across Islamic, Hindu, Christian and Italian traditions.`
  : 'Search 42,000+ baby names by name, meaning, origin, religion, gender or category. Filter results and rank by popularity — free and instant.';

---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <div class="container-page py-10 sm:py-14">
    <div class="mx-auto max-w-5xl">
      <header class="mb-8 text-center">
        <span class="eyebrow">Instant name search</span>
        <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-nv-text sm:text-4xl">
          {activeFilters.length ? `${activeFilters.join(' ')}` : 'Search Baby Names'}
        </h1>
        <p class="mx-auto mt-3 max-w-2xl text-nv-text-secondary">
          Search {religions.length > 0 ? '42,000+' : ''} baby names by name, meaning, origin, religion, gender or category —
          then rank results by popularity.
        </p>
      </header>

      <form action="/search" method="get" id="search-form" class="card p-4 sm:p-5">
        <div class="flex gap-2">
          <input
            type="search"
            id="search-input"
            name="q"
            value={query}
            placeholder="Try a name, meaning or origin…"
            aria-label="Search baby names by name, meaning or origin"
            autocomplete="off"
            class="input flex-1"
          />
          <button type="submit" class="btn-primary shrink-0">Search</button>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-4">
          <label class="block">
            <span class="mb-1 block text-xs font-bold uppercase tracking-wide text-nv-text-muted">Religion</span>
            <select name="religion" class="input !py-2" id="f-religion" aria-label="Filter by religion">
              <option value="">All traditions</option>
              {religions.map((r) => (
                <option value={r} selected={religion === r}>{religionLabels[r]}</option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="mb-1 block text-xs font-bold uppercase tracking-wide text-nv-text-muted">Gender</span>
            <select name="gender" class="input !py-2" id="f-gender" aria-label="Filter by gender">
              <option value="">Any gender</option>
              {['boy', 'girl', 'unisex'].map((g) => (
                <option value={g} selected={gender === g}>{genderLabels[g]}</option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="mb-1 block text-xs font-bold uppercase tracking-wide text-nv-text-muted">Origin</span>
            <select name="origin" class="input !py-2" id="f-origin" aria-label="Filter by origin">
              <option value="">Any origin</option>
              {Object.entries(originLabels).map(([slug, label]) => (
                <option value={slug} selected={origin === slug}>{label}</option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="mb-1 block text-xs font-bold uppercase tracking-wide text-nv-text-muted">Sort by</span>
            <select name="sort" class="input !py-2" id="f-sort" aria-label="Sort search results">
              <option value="relevance" selected>Relevance</option>
              <option value="popularity">Most popular</option>
              <option value="name">Name (A–Z)</option>
            </select>
          </label>
        </div>
      </form>

      <p class="mt-3 text-xs text-nv-text-muted">
        Try:
        <a href="/search?q=light" class="font-semibold text-nv-accent hover:underline">light</a>,
        <a href="/search?q=love" class="ml-1 font-semibold text-nv-accent hover:underline">love</a>,
        <a href="/search?q=strength" class="ml-1 font-semibold text-nv-accent hover:underline">strength</a>,
        <a href="/search?religion=islamic&gender=boy&sort=popularity" class="ml-1 font-semibold text-nv-accent hover:underline">popular Islamic boy names</a>
      </p>

      <div class="mt-8">
        <div id="search-status" class="mb-4 text-sm font-semibold text-nv-text-secondary" data-query={query.toLowerCase()} aria-live="polite"></div>
        <div id="search-results" class="space-y-3"></div>
      </div>

      <!-- SEO content for the search tool -->
      <section class="mt-16" aria-labelledby="search-seo-heading">
        <div class="mx-auto max-w-3xl">
          <h2 id="search-seo-heading" class="font-display text-2xl font-semibold tracking-tight text-nv-text sm:text-3xl">
            The smartest way to find a baby name
          </h2>
          <div class="mt-4 space-y-4 text-sm leading-relaxed text-nv-text-secondary sm:text-base">
            <p>
              NameVerse indexes every one of its 42,000+ names so you can search the way you actually
              think — by a name you heard, a meaning you love, a language you come from, or a faith
              you follow. Because every record carries its religion, gender, origin, category and
              popularity score, a single search can answer "Arabic girl names that mean light" as
              easily as it can find a specific spelling.
            </p>
            <p>
              Use the filters above to combine traditions with gender, then sort by popularity to see
              which choices are beloved by parents right now. Every result opens into a full profile
              with pronunciation, lucky numbers, numerology, name variations and cultural context.
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>

  <script>
    (function () {
      const input = document.getElementById('search-input');
      const form = document.getElementById('search-form');
      const statusEl = document.getElementById('search-status');
      const resultsEl = document.getElementById('search-results');
      const relSel = document.getElementById('f-religion');
      const genSel = document.getElementById('f-gender');
      const oriSel = document.getElementById('f-origin');
      const sortSel = document.getElementById('f-sort');
      if (!input || !resultsEl || !form) return;

      const religions = ['islamic', 'christian', 'hindu', 'italian'];
      const religionLabels = { christian: 'Christian', hindu: 'Hindu', islamic: 'Islamic', italian: 'Italian' };
      const religionBadge = {
        christian: 'bg-christian-soft text-christian',
        hindu: 'bg-hindu-soft text-hindu',
        islamic: 'bg-islamic-soft text-islamic',
        italian: 'bg-italian-soft text-italian',
      };

      function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      }

      function normGender(g) {
        const s = String(g || '').toLowerCase();
        const f = /female|girl|feminine/.test(s);
        const m = /(^|[^e])male|\bboy|masculin/.test(s);
        if (m && f) return 'unisex';
        if (f) return 'girl';
        if (m) return 'boy';
        if (/unisex|neutral|unknown/.test(s)) return 'unisex';
        return null;
      }

      let indexes = null;
      let loading = null;

      function loadIndexes() {
        if (loading) return loading;
        loading = Promise.all(
          religions.map((r) =>
            fetch(`/names/${r}/_search-index.json`)
              .then((res) => (res.ok ? res.json() : []))
              .then((items) => items.map((item) => ({ ...item, religion: r })))
              .catch(() => [])
          )
        ).then((arrays) => {
          indexes = arrays.flat();
          return indexes;
        });
        return loading;
      }

      function render(query, sort) {
        if (!indexes) return;
        const q = query.trim().toLowerCase();
        const rFilter = relSel.value;
        const gFilter = genSel.value;
        const oFilter = oriSel.value;

        let list = indexes.filter((item) => {
          if (rFilter && item.religion !== rFilter) return false;
          if (gFilter && normGender(item.g) !== gFilter) return false;
          if (oFilter && String(item.o || '').toLowerCase() !== oFilter) return false;
          if (!q) return true;
          const name = item.n.toLowerCase();
          const meaning = (item.m || '').toLowerCase();
          return name.includes(q) || meaning.includes(q);
        });

        if (sort === 'popularity') {
          list.sort((a, b) => (b.p || 0) - (a.p || 0));
        } else if (sort === 'name') {
          list.sort((a, b) => a.n.localeCompare(b.n));
        } else {
          // Relevance
          if (q) {
            const ranked = list.map((item) => {
              const name = item.n.toLowerCase();
              let rank = 10;
              if (name === q) rank = 1;
              else if (name.startsWith(q)) rank = 2;
              else if (name.includes(q)) rank = 3;
              else if ((item.m || '').toLowerCase().includes(q)) rank = 4;
              return { item, r: rank };
            });
            ranked.sort((a, b) => a.r - b.r || (b.item.p || 0) - (a.item.p || 0));
            list = ranked.map((x) => x.item);
          }
        }

        const total = list.length;
        if (total === 0) {
          statusEl.textContent = q
            ? `No results for "${query.trim()}" — try a shorter keyword, a meaning like "light", or clear a filter.`
            : 'No names match those filters — try widening your search.';
          resultsEl.innerHTML = '';
          return;
        }

        statusEl.textContent = `${total.toLocaleString()} result${total === 1 ? '' : 's'}${q ? ` for "${query.trim()}"` : ''}${list.length > 60 ? ' — showing the top 60.' : ''}`;

        resultsEl.innerHTML = list
          .slice(0, 60)
          .map((item) => {
            const gender = normGender(item.g);
            const genderChip =
              gender === 'boy'
                ? '<span class="badge shrink-0 bg-sky-50 text-sky-700 dark:bg-sky-950/50 dark:text-sky-300">Boy</span>'
                : gender === 'girl'
                  ? '<span class="badge shrink-0 bg-rose-50 text-rose-700 dark:bg-rose-950/50 dark:text-rose-300">Girl</span>'
                  : gender === 'unisex'
                    ? '<span class="badge shrink-0 bg-purple-50 text-purple-700 dark:bg-purple-950/50 dark:text-purple-300">Unisex</span>'
                    : '';
            const score = Number(item.p) || 0;
            return `
              <a href="/names/${item.religion}/${item.s}" class="card card-hover flex flex-col gap-2 p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center gap-2">
                    <span class="truncate text-base font-bold text-nv-text">${escapeHtml(item.n)}</span>
                    ${genderChip}
                    ${score ? `<span class="badge bg-nv-surface-subtle text-nv-text-secondary">Popularity ${score}</span>` : ''}
                  </span>
                  <span class="mt-1 block truncate text-xs text-nv-text-muted">${escapeHtml(item.m || 'Meaning not available')}</span>
                </span>
                <span class="flex shrink-0 items-center gap-2">
                  <span class="badge ${religionBadge[item.religion] || 'bg-nv-subtle text-nv-text-secondary'}">${religionLabels[item.religion] || item.religion}</span>
                </span>
              </a>`;
          })
          .join('');
      }

      async function runSearch() {
        if (!indexes) {
          statusEl.textContent = 'Loading 42,000+ names…';
          await loadIndexes();
        }
        const params = new URLSearchParams(location.search);
        render(input.value, sortSel.value);
        // Update the URL without a full reload so filters are shareable
        params.set('q', input.value.trim());
        if (relSel.value) params.set('religion', relSel.value); else params.delete('religion');
        if (genSel.value) params.set('gender', genSel.value); else params.delete('gender');
        if (oriSel.value) params.set('origin', oriSel.value); else params.delete('origin');
        params.set('sort', sortSel.value || 'relevance');
        history.replaceState(null, '', `/search?${params.toString()}`);
      }

      let timer;
      input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(runSearch, 180);
      });
      [relSel, genSel, oriSel, sortSel].forEach((sel) => sel.addEventListener('change', runSearch));

      const initial = (statusEl.dataset.query || '').trim();
      if (initial || relSel.value || genSel.value || oriSel.value) {
        runSearch();
      } else {
        statusEl.textContent = 'Type a name, meaning or origin to begin — or browse the popular searches above.';
      }
    })();
  </script>
</Layout>
