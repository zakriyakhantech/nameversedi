---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Advanced Search | NameVerse" description="Advanced baby name search with filters for meaning, origin, religion and gender.">
  <main class="nv-page min-h-screen">
    <div class="nv-container nv-section">
      <div class="mx-auto max-w-3xl">
        <h1 class="nv-display text-3xl font-bold text-nv-text sm:text-4xl">Advanced Search</h1>
        <p class="mt-2 text-nv-text-secondary">Use the search below to find names by meaning, origin, religion or keyword.</p>

        <form action="/search" method="get" class="mt-6 flex gap-2">
          <input
            type="search"
            name="q"
            placeholder="Search names, meanings, origins..."
            autocomplete="off"
            class="flex-1 rounded-2xl border border-nv-border bg-white px-4 py-3 text-sm text-nv-text placeholder:text-nv-text-muted focus:outline-none focus:ring-2 focus:ring-[color:var(--nv-accent-2)]"
          />
          <button
            type="submit"
            class="rounded-2xl bg-[color:var(--nv-ink)] px-6 py-3 text-sm font-bold text-white transition hover:bg-slate-800"
          >
            Search
          </button>
        </form>
      </div>
    </div>
  </main>
</Layout>
