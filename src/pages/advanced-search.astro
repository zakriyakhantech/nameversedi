---
import Layout from '../layouts/Layout.astro';

const religions = ['islamic', 'christian', 'hindu', 'italian'];
const religionLabels = { christian: 'Christian', hindu: 'Hindu', islamic: 'Islamic', italian: 'Italian' };
const originOptions = {
  arabic: 'Arabic', biblical: 'Biblical', sanskrit: 'Sanskrit', hindu: 'Hindu',
  italian: 'Italian', persian: 'Persian', english: 'English', tamil: 'Tamil',
  hindi: 'Hindi', bengali: 'Bengali', urdu: 'Urdu',
};
const categoryOptions = { islamic: 'Islamic', hindu: 'Hindu', biblical: 'Biblical', saint: 'Saint', virtue: 'Virtue', italian: 'Italian' };
const genderOptions = { boy: 'Boy', girl: 'Girl', unisex: 'Unisex' };

---

<Layout
  title="Advanced Baby Name Search — Filter by Religion, Gender, Origin & Category | NameVerse"
  description="Advanced baby name search with multi-filters: combine religion, gender, origin, category and popularity across 42,000+ Islamic, Hindu, Christian and Italian names."
  noindex={true}
>
    <div class="container-page py-10 sm:py-14">
    <div class="mx-auto max-w-6xl">
      <header class="mb-8 text-center">
        <span class="eyebrow">Advanced search</span>
        <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-nv-text sm:text-4xl">
          Advanced Baby Name Search
        </h1>
        <p class="mx-auto mt-3 max-w-2xl text-nv-text-secondary">
          Combine a keyword with multiple religions, genders, origins and categories. Results update
          live and can be ranked by popularity.
        </p>
      </header>

      <div class="grid gap-6 lg:grid-cols-[320px_1fr]">
        <!-- Filters -->
        <aside class="card h-fit p-5 lg:sticky lg:top-20">
          <label class="block">
            <span class="mb-1 block text-xs font-bold uppercase tracking-wide text-nv-text-muted">Keyword</span>
            <input type="search" id="adv-q" placeholder="Name, meaning or origin…" aria-label="Keyword search" autocomplete="off" class="input" />
          </label>

          <fieldset class="mt-5">
            <legend class="mb-2 text-xs font-bold uppercase tracking-wide text-nv-text-muted">Religion</legend>
            <div class="flex flex-wrap gap-2" id="adv-religions">
              {religions.map((r) => (
                <label class="filter-chip">
                  <input type="checkbox" value={r} checked />
                  <span>{religionLabels[r]}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="mt-5">
            <legend class="mb-2 text-xs font-bold uppercase tracking-wide text-nv-text-muted">Gender</legend>
            <div class="flex flex-wrap gap-2" id="adv-genders">
              {Object.entries(genderOptions).map(([slug, label]) => (
                <label class="filter-chip">
                  <input type="checkbox" value={slug} />
                  <span>{label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="mt-5">
            <legend class="mb-2 text-xs font-bold uppercase tracking-wide text-nv-text-muted">Category</legend>
            <div class="flex flex-wrap gap-2" id="adv-cats">
              {Object.entries(categoryOptions).map(([slug, label]) => (
                <label class="filter-chip">
                  <input type="checkbox" value={slug} />
                  <span>{label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="mt-5">
            <legend class="mb-2 text-xs font-bold uppercase tracking-wide text-nv-text-muted">Origin</legend>
            <div class="flex flex-wrap gap-2" id="adv-origins">
              {Object.entries(originOptions).map(([slug, label]) => (
                <label class="filter-chip">
                  <input type="checkbox" value={slug} />
                  <span>{label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <label class="mt-5 block">
            <span class="mb-1 block text-xs font-bold uppercase tracking-wide text-nv-text-muted">Sort by</span>
            <select id="adv-sort" class="input !py-2" aria-label="Sort advanced search results">
              <option value="relevance">Relevance</option>
              <option value="popularity">Most popular</option>
              <option value="name">Name (A–Z)</option>
            </select>
          </label>

          <button id="adv-clear" type="button" class="mt-4 w-full rounded-xl border border-nv-border bg-nv-surface px-4 py-2 text-sm font-semibold text-nv-text-secondary transition hover:border-nv-accent/50 hover:text-nv-accent">
            Clear all filters
          </button>
        </aside>

        <!-- Results -->
        <div class="min-w-0">
          <div id="adv-status" class="mb-4 text-sm font-semibold text-nv-text-secondary" aria-live="polite"></div>
          <div id="adv-results" class="space-y-3"></div>
        </div>
      </div>

      <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="adv-seo">
        <h2 id="adv-seo" class="font-display text-2xl font-semibold tracking-tight text-nv-text sm:text-3xl">
          Combine filters like a naming expert
        </h2>
        <div class="mt-4 space-y-4 text-sm leading-relaxed text-nv-text-secondary sm:text-base">
          <p>
            The strongest baby-name shortlists come from layering the filters that matter to your
            family. Tick two religions if your family spans traditions, narrow to one gender when you
            have a preference, pick a Virtue category to find names that express love, peace or
            strength, and sort by popularity to start with names parents are choosing today.
          </p>
          <p>
            Every result links to a full name profile with pronunciation, lucky numbers, numerology,
            spelling variations and cultural context — so shortlisting is only the first step.
          </p>
        </div>

        </section>
    </div>
  </div>

  <style>
    .filter-chip input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }
    .filter-chip span {
      display: inline-flex;
      align-items: center;
      border-radius: 9999px;
      border: 1px solid rgb(var(--nv-line) / 1);
      background: rgb(var(--nv-surface) / 1);
      padding: 0.375rem 0.75rem;
      font-size: 0.75rem;
      font-weight: 600;
      color: rgb(var(--nv-secondary) / 1);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .filter-chip input:checked + span {
      border-color: rgb(var(--nv-accent) / 1);
      background: rgb(var(--nv-accent-subtle) / 1);
      color: rgb(var(--nv-accent) / 1);
    }
  </style>

  <script>
    (function () {
      const q = document.getElementById('adv-q');
      const resultsEl = document.getElementById('adv-results');
      const statusEl = document.getElementById('adv-status');
      const sortSel = document.getElementById('adv-sort');
      const clearBtn = document.getElementById('adv-clear');
      const relWrap = document.getElementById('adv-religions');
      const genWrap = document.getElementById('adv-genders');
      const catWrap = document.getElementById('adv-cats');
      const oriWrap = document.getElementById('adv-origins');

      const religionLabels = { christian: 'Christian', hindu: 'Hindu', islamic: 'Islamic', italian: 'Italian' };
      const religionBadge = {
        christian: 'bg-christian-soft text-christian',
        hindu: 'bg-hindu-soft text-hindu',
        islamic: 'bg-islamic-soft text-islamic',
        italian: 'bg-italian-soft text-italian',
      };
      const ORIGIN_ORDER = ['arabic', 'biblical', 'sanskrit', 'hindu', 'italian', 'persian', 'english', 'tamil', 'hindi', 'bengali', 'urdu'];
      const CAT_ORDER = ['islamic', 'hindu', 'biblical', 'saint', 'virtue', 'italian'];

      let indexes = null;
      let loading = null;

      function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      }
      function normGender(g) {
        const s = String(g || '').toLowerCase();
        const f = /female|girl|feminine/.test(s);
        const m = /(^|[^e])male|\bboy|masculin/.test(s);
        if (m && f) return 'unisex';
        if (f) return 'girl';
        if (m) return 'boy';
        if (/unisex|neutral|unknown/.test(s)) return 'unisex';
        return null;
      }
      function originSlug(o) {
        const s = String(o || '').toLowerCase();
        for (const slug of ORIGIN_ORDER) if (s.includes(slug)) return slug;
        return null;
      }
      function catSlug(c) {
        const s = String(c || '').toLowerCase();
        for (const slug of CAT_ORDER) if (s.includes(slug)) return slug;
        return null;
      }
      function checked(wrap) {
        const out = new Set();
        wrap.querySelectorAll('input:checked').forEach((i) => out.add(i.value));
        return out;
      }

      function loadIndexes() {
        if (loading) return loading;
        loading = Promise.all(
          ['islamic', 'christian', 'hindu', 'italian'].map((r) =>
            fetch(`/names/${r}/_search-index.json`)
              .then((res) => res.json())
              .then((items) => items.map((item) => ({ ...item, religion: r })))
          )
        ).then((arrays) => (indexes = arrays.flat())).catch(() => (indexes = []));
        return loading;
      }

      function rankHit(item, q) {
        const name = item.n.toLowerCase();
        const meaning = item.m.toLowerCase();
        if (name === q) return 0;
        if (name.startsWith(q)) return 1;
        if (name.includes(q)) return 2;
        if (meaning.includes(q)) return 3;
        return 99;
      }

      function run() {
        if (!indexes) return;
        const query = q.value.trim().toLowerCase();
        const rels = checked(relWrap);
        const gens = checked(genWrap);
        const cats = checked(catWrap);
        const oris = checked(oriWrap);
        const sort = sortSel.value;

        const pool = indexes.filter((item) => {
          if (!rels.has(item.religion)) return false;
          if (gens.size) {
            const g = normGender(item.g);
            if (!g || !gens.has(g)) return false;
          }
          if (oris.size && !oris.has(originSlug(item.o))) return false;
          if (cats.size && !cats.has(catSlug(item.c))) return false;
          if (query && rankHit(item, query) === 99) return false;
          return true;
        });

        let list;
        if (sort === 'popularity') list = pool.slice().sort((a, b) => (b.p || 0) - (a.p || 0));
        else if (sort === 'name') list = pool.slice().sort((a, b) => a.n.localeCompare(b.n));
        else if (!query) list = pool.slice().sort((a, b) => (b.p || 0) - (a.p || 0));
        else {
          const ranked = pool.map((item) => ({ item, r: rankHit(item, query) }));
          ranked.sort((a, b) => a.r - b.r || (b.item.p || 0) - (a.item.p || 0));
          list = ranked.map((x) => x.item);
        }

        if (!list.length) {
          statusEl.textContent = 'No names match those filters — try widening your search.';
          resultsEl.innerHTML = '';
          return;
        }
        statusEl.textContent = `${list.length.toLocaleString()} names match your filters${list.length > 60 ? ' — showing the top 60.' : ''}`;
        resultsEl.innerHTML = list
          .slice(0, 60)
          .map((item) => {
            const gender = normGender(item.g);
            const genderChip =
              gender === 'boy' ? '<span class="badge shrink-0 bg-sky-50 text-sky-700 dark:bg-sky-950/50 dark:text-sky-300">Boy</span>'
              : gender === 'girl' ? '<span class="badge shrink-0 bg-rose-50 text-rose-700 dark:bg-rose-950/50 dark:text-rose-300">Girl</span>'
              : gender === 'unisex' ? '<span class="badge shrink-0 bg-purple-50 text-purple-700 dark:bg-purple-950/50 dark:text-purple-300">Unisex</span>' : '';
            return `
              <a href="/names/${item.religion}/${item.s}" class="card card-hover flex flex-col gap-2 p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center gap-2">
                    <span class="truncate text-base font-bold text-nv-text">${escapeHtml(item.n)}</span>
                    ${genderChip}
                    ${Number(item.p) ? `<span class="badge bg-nv-surface-subtle text-nv-text-secondary">Popularity ${item.p}</span>` : ''}
                  </span>
                  <span class="mt-1 block truncate text-xs text-nv-text-muted">${escapeHtml(item.m || 'Meaning not available')}</span>
                </span>
                <span class="badge shrink-0 ${religionBadge[item.religion] || 'bg-nv-subtle text-nv-text-secondary'}">${religionLabels[item.religion] || item.religion}</span>
              </a>`;
          })
          .join('');
      }

      let timer;
      q.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(run, 180);
      });
      [relWrap, genWrap, catWrap, oriWrap].forEach((w) => w.addEventListener('change', run));
      sortSel.addEventListener('change', run);
      clearBtn.addEventListener('click', () => {
        document.querySelectorAll('#adv-religions input, #adv-genders input, #adv-cats input, #adv-origins input').forEach((i) => (i.checked = false));
        q.value = '';
        run();
      });

      loadIndexes().then(() => {
        statusEl.textContent = 'Ready — pick filters or type a keyword to begin.';
      });
    })();
  </script>
</Layout>


