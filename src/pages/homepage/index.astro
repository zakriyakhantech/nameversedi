---
// NameVerse homepage — content fragment rendered inside Layout by /index.astro
import { getManifest, getPopularSlugs } from '../../lib/data/astro-data.mjs';

const manifest = getManifest();
const religions = ['islamic', 'christian', 'hindu', 'italian'];
const counts = Object.fromEntries(religions.map((r) => [r, (manifest[r] || []).length]));
const totalNames = religions.reduce((sum, r) => sum + counts[r], 0);

// Top popular names for the trending rail (real data from the manifest)
const popularSlugs = getPopularSlugs(12);
const bySlug = {};
for (const r of religions) {
  for (const item of manifest[r] || []) bySlug[item.slug] = item;
}
const popularNames = popularSlugs
  .map(({ slug }) => bySlug[slug])
  .filter(Boolean);

const hubs = [
  {
    religion: 'islamic',
    label: 'Islamic Names',
    description: 'Quranic, Arabic and Urdu names with meanings and lucky numbers.',
    href: '/names/islamic/letter/a',
    badgeClass: 'bg-islamic-soft text-islamic',
  },
  {
    religion: 'christian',
    label: 'Christian Names',
    description: 'Biblical, Hebrew, Greek and modern Christian names.',
    href: '/names/christian/letter/a',
    badgeClass: 'bg-christian-soft text-christian',
  },
  {
    religion: 'hindu',
    label: 'Hindu Names',
    description: 'Sanskrit, Vedic and regional names with spiritual roots.',
    href: '/names/hindu/letter/a',
    badgeClass: 'bg-hindu-soft text-hindu',
  },
  {
    religion: 'italian',
    label: 'Italian Names',
    description: 'Classical Italian names with cultural heritage.',
    href: '/names/italian/letter/a',
    badgeClass: 'bg-italian-soft text-italian',
  },
];

const genderLinks = [
  { label: 'Islamic Boy Names', href: '/islamic-boy-names' },
  { label: 'Islamic Girl Names', href: '/islamic-girl-names' },
  { label: 'Christian Boy Names', href: '/christian-boy-names' },
  { label: 'Christian Girl Names', href: '/christian-girl-names' },
  { label: 'Hindu Boy Names', href: '/hindu-boy-names' },
  { label: 'Hindu Girl Names', href: '/hindu-girl-names' },
];

const meaningChips = ['light', 'love', 'strength', 'peace', 'blessing', 'wisdom', 'courage', 'grace'];

const intentChips = [
  { label: 'Boy names', href: '/search?q=boy' },
  { label: 'Girl names', href: '/search?q=girl' },
  { label: 'Names that mean light', href: '/search?q=light' },
  { label: 'Names that mean love', href: '/search?q=love' },
  { label: 'Names that mean strength', href: '/search?q=strength' },
  { label: 'Unique names', href: '/search?q=unique' },
];

const latestArticles = [
  {
    title: 'Top Islamic Baby Names for 2026',
    excerpt: 'The most searched Muslim baby names this year, with meanings and origins.',
    href: '/blog/top-islamic-baby-names-2026',
    date: 'Jan 2026',
  },
  {
    title: 'Hindu Baby Names with Deep Meanings',
    excerpt: 'Sanskrit and Vedic names carrying spiritual significance and heritage.',
    href: '/blog/hindu-baby-names-meanings',
    date: 'Jan 2026',
  },
  {
    title: 'Christian Baby Names from the Bible',
    excerpt: 'Timeless biblical names with Hebrew and Greek roots, explained.',
    href: '/blog/christian-baby-names-bible',
    date: 'Dec 2025',
  },
];

const faqs = [
  {
    question: 'How do I find the best baby name with meaning?',
    answer:
      'Search by name, meaning, origin or religion. NameVerse connects each query to curated name lists, cultural context and related browsing paths so you can compare options quickly.',
  },
  {
    question: 'Can I search names by religion, origin or meaning?',
    answer:
      'Yes. Browse Islamic, Hindu and Christian names by religion, then narrow by origins such as Arabic, Urdu, Persian, Sanskrit, Hebrew, Greek or Latin. You can also search meanings such as light, love, strength or peace.',
  },
  {
    question: 'Are NameVerse meanings verified?',
    answer:
      'NameVerse prioritizes verified meanings and cultural context. Entries are reviewed for linguistic origin, common usage and faith-aware interpretation before being surfaced in search and curated lists.',
  },
  {
    question: 'Is NameVerse free to use?',
    answer:
      'Yes. Search, name meanings, browsing pages, FAQs and discovery tools are free for parents, families and researchers.',
  },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
});
---

<script type="application/ld+json" set:html={faqJsonLd}></script>

<!-- Hero -->
<section class="relative overflow-hidden border-b border-nv-border">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-24 left-1/2 h-72 w-[36rem] -translate-x-1/2 rounded-full bg-nv-accent/10 blur-3xl"></div>
  </div>

  <div class="container-page relative py-12 sm:py-16 lg:py-20">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <span class="badge bg-nv-accent-subtle text-nv-accent">42,000+ names &bull; verified meanings</span>
        <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.05] tracking-tight text-nv-text sm:text-5xl lg:text-6xl">
          Baby names with meanings, origins &amp; cultural roots.
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-nv-text-secondary sm:text-lg">
          Search Islamic, Hindu, Christian and global names with verified meanings, lucky numbers,
          pronunciation guides and parent-friendly research tools.
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          {intentChips.map((chip) => (
            <a
              href={chip.href}
              class="rounded-full border border-nv-border bg-nv-surface px-3.5 py-1.5 text-xs font-semibold text-nv-text-secondary transition hover:border-nv-accent/50 hover:text-nv-accent"
            >
              {chip.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Search card -->
      <div class="card p-6">
        <form action="/search" method="get" id="homepage-search-form" class="flex flex-col gap-3">
          <label for="homepage-search" class="eyebrow">Search names</label>
          <div class="relative">
            <input
              type="search"
              id="homepage-search"
              name="q"
              placeholder="Try a name, meaning or origin…"
              autocomplete="off"
              class="input pr-12"
            />
            <button
              type="submit"
              class="absolute right-1.5 top-1/2 grid h-9 w-9 -translate-y-1/2 place-items-center rounded-lg bg-nv-primary text-white transition hover:bg-nv-primary-hover"
              aria-label="Search"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </button>
            <div
              id="search-suggestions"
              class="absolute left-0 right-0 top-full z-50 mt-2 hidden max-h-80 overflow-y-auto rounded-xl border border-nv-border bg-nv-surface shadow-card-hover"
            ></div>
          </div>
          <p class="text-xs text-nv-text-muted">
            Popular: <a href="/search?q=light" class="font-semibold text-nv-accent hover:underline">light</a>,
            <a href="/search?q=love" class="ml-1 font-semibold text-nv-accent hover:underline">love</a>,
            <a href="/search?q=strength" class="ml-1 font-semibold text-nv-accent hover:underline">strength</a>
          </p>
        </form>
      </div>
    </div>

    <!-- Stats -->
    <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {[
        { value: `${Math.round(totalNames / 1000)}K+`, label: 'Names in database' },
        { value: '4', label: 'Tradition hubs' },
        { value: '15+', label: 'Language roots' },
        { value: 'Free', label: 'Forever, for parents' },
      ].map((stat) => (
        <div class="card p-4 text-center">
          <div class="font-display text-2xl font-bold text-nv-text">{stat.value}</div>
          <div class="mt-1 text-xs font-semibold text-nv-text-muted">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Religion hubs -->
<section class="container-page py-12 sm:py-16" aria-labelledby="hubs-title">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <span class="eyebrow">Browse by tradition</span>
      <h2 id="hubs-title" class="mt-2 font-display text-2xl font-semibold tracking-tight text-nv-text sm:text-3xl">
        Explore names by faith &amp; culture
      </h2>
    </div>
    <a href="/names" class="btn-ghost">View full directory</a>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      hubs.map((hub) => (
        <a href={hub.href} class="card card-hover group flex flex-col gap-3 p-6">
          <span class:list={['badge w-fit', hub.badgeClass]}>{counts[hub.religion].toLocaleString()} names</span>
          <h3 class="font-display text-xl font-semibold text-nv-text group-hover:text-nv-accent">{hub.label}</h3>
          <p class="text-sm leading-relaxed text-nv-text-secondary">{hub.description}</p>
          <span class="mt-auto inline-flex items-center gap-1.5 pt-2 text-sm font-semibold text-nv-accent">
            Browse names
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
      ))
    }
  </div>

  <div class="mt-6 flex flex-wrap justify-center gap-2">
    {genderLinks.map((g) => (
      <a href={g.href} class="rounded-full border border-nv-border bg-nv-surface px-4 py-2 text-sm font-semibold text-nv-text-secondary transition hover:border-nv-accent/50 hover:text-nv-accent">
        {g.label}
      </a>
    ))}
  </div>
</section>

<!-- Popular names -->
<section class="border-y border-nv-border bg-nv-surface" aria-labelledby="popular-title">
  <div class="container-page py-12 sm:py-16">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="eyebrow">Trending now</span>
        <h2 id="popular-title" class="mt-2 font-display text-2xl font-semibold tracking-tight text-nv-text sm:text-3xl">
          Popular names parents are searching
        </h2>
      </div>
      <a href="/names" class="btn-ghost">See all popular names</a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {popularNames.slice(0, 12).map((item) => (
        <a href={`/names/${item.religion}/${item.slug}`} class="card card-hover group p-5">
          <div class="text-xs font-bold uppercase tracking-[0.14em] text-nv-accent">{item.origin || item.religion}</div>
          <h3 class="mt-2 font-display text-lg font-semibold text-nv-text group-hover:text-nv-accent">{item.name}</h3>
          <p class="mt-1.5 line-clamp-2 text-sm text-nv-text-secondary">{item.meaning}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Meaning-led discovery -->
<section class="container-page py-12 sm:py-16" aria-labelledby="meaning-title">
  <div class="rounded-card bg-nv-primary p-6 text-white sm:p-10 dark:bg-nv-surface dark:border dark:border-nv-border">
    <div class="grid gap-8 lg:grid-cols-[1fr_0.9fr] lg:items-center">
      <div>
        <span class="badge bg-white/15 text-white">Meaning-led discovery</span>
        <h2 id="meaning-title" class="mt-4 font-display text-2xl font-semibold leading-tight sm:text-4xl">
          Find a name by what it means to you.
        </h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-white/75 sm:text-base">
          Parents search for values, not just spellings: light, strength, love, peace. Search any
          meaning and NameVerse matches it across all traditions.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {meaningChips.map((m) => (
            <a
              href={`/search?q=${m}`}
              class="rounded-full bg-white px-4 py-2 text-sm font-bold text-nv-primary transition hover:bg-white/85"
            >
              Names that mean {m}
            </a>
          ))}
        </div>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <a href="/search" class="rounded-card bg-white/10 p-5 transition hover:bg-white/15">
          <h3 class="text-base font-bold">Smart search</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70">Search names, meanings, origins and gender across 42K+ records.</p>
        </a>
        <a href="/names/islamic/letter/a" class="rounded-card bg-white/10 p-5 transition hover:bg-white/15">
          <h3 class="text-base font-bold">A–Z browsing</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70">Browse every tradition alphabetically, letter by letter.</p>
        </a>
        <a href="/guides/expert-naming-guide" class="rounded-card bg-white/10 p-5 transition hover:bg-white/15">
          <h3 class="text-base font-bold">Naming guide</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70">A decision framework for choosing with confidence.</p>
        </a>
        <a href="/blog" class="rounded-card bg-white/10 p-5 transition hover:bg-white/15">
          <h3 class="text-base font-bold">Expert articles</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70">Curated lists and cultural context from our editors.</p>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Latest articles -->
<section class="container-page pb-12 sm:pb-16" aria-labelledby="articles-title">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <span class="eyebrow">From the blog</span>
      <h2 id="articles-title" class="mt-2 font-display text-2xl font-semibold tracking-tight text-nv-text sm:text-3xl">
        Expert naming guides
      </h2>
    </div>
    <a href="/blog" class="btn-ghost">View all articles</a>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {latestArticles.map((a) => (
      <a href={a.href} class="card card-hover group flex flex-col gap-2.5 p-6">
        <span class="text-xs font-bold uppercase tracking-[0.14em] text-nv-accent">{a.date}</span>
        <h3 class="font-display text-lg font-semibold leading-snug text-nv-text group-hover:text-nv-accent">{a.title}</h3>
        <p class="text-sm leading-relaxed text-nv-text-secondary">{a.excerpt}</p>
        <span class="mt-auto pt-2 text-sm font-semibold text-nv-accent">Read article &rarr;</span>
      </a>
    ))}
  </div>
</section>

<!-- FAQ -->
<section class="container-page pb-12 sm:pb-16" aria-labelledby="faq-title">
  <div class="mx-auto max-w-3xl">
    <div class="mb-8 text-center">
      <span class="eyebrow">FAQ</span>
      <h2 id="faq-title" class="mt-2 font-display text-2xl font-semibold tracking-tight text-nv-text sm:text-3xl">
        Questions parents ask before choosing a name
      </h2>
    </div>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="faq-item card group p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-bold text-nv-text">
            {faq.question}
            <svg class="faq-chevron h-4 w-4 shrink-0 text-nv-text-muted" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-nv-text-secondary">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- Final CTA -->
<section class="container-page pb-16" aria-label="Get started">
  <div class="card p-8 text-center sm:p-12">
    <h2 class="font-display text-2xl font-semibold tracking-tight text-nv-text sm:text-4xl">
      Find a name with meaning, origin and confidence.
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-nv-text-secondary sm:text-base">
      Start with a search, explore by meaning, or browse a tradition. NameVerse makes name research
      fast, clear and trustworthy.
    </p>
    <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/search" class="btn-primary">Search names</a>
      <a href="/names/islamic/letter/a" class="btn-ghost">Browse Islamic names</a>
    </div>
  </div>
</section>

<script>
  // Homepage live search suggestions — indexes load lazily on first keystroke.
  (function () {
    const input = document.getElementById('homepage-search');
    const suggestions = document.getElementById('search-suggestions');
    const form = document.getElementById('homepage-search-form');
    if (!input || !suggestions) return;

    const religionLabels = { christian: 'Christian', hindu: 'Hindu', islamic: 'Islamic', italian: 'Italian' };
    let indexes = null;
    let loading = null;

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function loadIndexes() {
      if (loading) return loading;
      loading = Promise.all(
        ['islamic', 'christian', 'hindu'].map((r) =>
          fetch(`/names/${r}/_search-index.json`)
            .then((res) => res.json())
            .then((items) => items.map((item) => ({ ...item, religion: r })))
        )
      )
        .then((arrays) => {
          indexes = arrays.flat();
          return indexes;
        })
        .catch(() => {
          indexes = [];
          return indexes;
        });
      return loading;
    }

    function render(items) {
      if (!items.length) {
        suggestions.innerHTML = '<div class="p-4 text-sm text-nv-text-muted">No matching names found.</div>';
        suggestions.classList.remove('hidden');
        return;
      }
      suggestions.innerHTML = items
        .slice(0, 8)
        .map(
          (item) => `
            <a href="/names/${item.religion}/${item.slug}" class="flex items-center justify-between gap-3 border-b border-nv-border px-4 py-3 text-sm last:border-b-0 hover:bg-nv-subtle">
              <span class="min-w-0">
                <span class="block truncate font-semibold text-nv-text">${escapeHtml(item.name)}</span>
                <span class="block truncate text-xs text-nv-text-muted">${escapeHtml(item.meaning || '')}</span>
              </span>
              <span class="badge shrink-0 bg-nv-accent-subtle text-nv-accent">${religionLabels[item.religion] || item.religion}</span>
            </a>`
        )
        .join('');
      suggestions.classList.remove('hidden');
    }

    function close() {
      suggestions.classList.add('hidden');
    }

    async function search() {
      const query = input.value.trim().toLowerCase();
      if (!query) {
        close();
        return;
      }
      const data = indexes || (await loadIndexes());
      const filtered = data.filter(
        (item) =>
          item.name.toLowerCase().includes(query) ||
          (item.meaning && item.meaning.toLowerCase().includes(query))
      );
      render(filtered);
    }

    let timer;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(search, 150);
    });
    input.addEventListener('focus', () => {
      if (input.value.trim()) search();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    document.addEventListener('click', (e) => {
      if (!form.contains(e.target)) close();
    });
  })();
</script>
