  <script>
    (function() {
      const input = document.getElementById('homepage-search');
      const suggestions = document.getElementById('search-suggestions');
      const form = document.getElementById('homepage-search-form');
      if (!input || !suggestions) return;

      const religionLabels = {
        christian: 'Christian',
        hindu: 'Hindu',
        islamic: 'Islamic'
      };

      const religionColors = {
        christian: 'bg-blue-50 text-blue-700',
        hindu: 'bg-orange-50 text-orange-700',
        islamic: 'bg-emerald-50 text-emerald-700'
      };

      let indexes = [];
      let currentFocus = -1;

      async function loadIndexes() {
        try {
          const [christian, hindu, islamic] = await Promise.all([
            fetch('/names/christian/_search-index.json').then(r => r.json()),
            fetch('/names/hindu/_search-index.json').then(r => r.json()),
            fetch('/names/islamic/_search-index.json').then(r => r.json())
          ]);
          indexes = [
            ...christian.map(item => ({ ...item, religion: 'christian' })),
            ...hindu.map(item => ({ ...item, religion: 'hindu' })),
            ...islamic.map(item => ({ ...item, religion: 'islamic' }))
          ];
        } catch (e) {
          console.error('Failed to load search indexes', e);
        }
      }

      function renderResults(items) {
        if (!items.length) {
          suggestions.innerHTML = '<div class="p-3 text-sm text-gray-500">No matching names found.</div>';
          suggestions.classList.remove('hidden');
          return;
        }
        suggestions.innerHTML = items.slice(0, 8).map((item, idx) => {
          const href = `/names/${item.religion}/${item.slug}`;
          return `
            <a href="${href}" class="flex items-center justify-between gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 border-b border-gray-100 last:border-b-0">
              <div class="flex flex-col">
                <span class="font-semibold text-gray-900">${item.name}</span>
                <span class="text-xs text-gray-500">${item.meaning}</span>
              </div>
              <span class="rounded-full px-2 py-1 text-xs font-bold ${religionColors[item.religion] || 'bg-gray-100 text-gray-700'}">${religionLabels[item.religion] || item.religion}</span>
            </a>
          `;
        }).join('');
        suggestions.classList.remove('hidden');
      }

      function closeSuggestions() {
        suggestions.classList.add('hidden');
        currentFocus = -1;
      }

      input.addEventListener('input', function() {
        const query = this.value.trim().toLowerCase();
        if (!query) {
          closeSuggestions();
          return;
        }
        if (!indexes.length) {
          loadIndexes().then(() => {
            const filtered = indexes.filter(item =>
              item.name.toLowerCase().includes(query) ||
              item.slug.toLowerCase().includes(query) ||
              (item.meaning && item.meaning.toLowerCase().includes(query))
            );
            renderResults(filtered);
          });
          return;
        }
        const filtered = indexes.filter(item =>
          item.name.toLowerCase().includes(query) ||
          item.slug.toLowerCase().includes(query) ||
          (item.meaning && item.meaning.toLowerCase().includes(query))
        );
        renderResults(filtered);
      });

      input.addEventListener('keydown', function(e) {
        const items = suggestions.querySelectorAll('a');
        if (!items.length) return;
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          currentFocus = Math.min(currentFocus + 1, items.length - 1);
          items[currentFocus]?.focus();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          currentFocus = Math.max(currentFocus - 1, 0);
          items[currentFocus]?.focus();
        } else if (e.key === 'Escape') {
          closeSuggestions();
        }
      });

      document.addEventListener('click', function(e) {
        if (!form.contains(e.target)) {
          closeSuggestions();
        }
      });

      loadIndexes();
    })();
  </script>
