---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Terms of Service | NameVerse" description="NameVerse terms of service and usage guidelines.">
  <main class="nv-page min-h-screen">
    <div class="nv-container nv-section">
      <div class="mx-auto max-w-3xl">
        <h1 class="nv-display text-3xl font-bold text-nv-text sm:text-4xl">Terms of Service</h1>
        <p class="mt-4 text-nv-text-secondary">Please read these terms carefully.</p>
        <div class="mt-6 space-y-4 rounded-2xl border border-nv-border bg-white p-6">
          <p class="text-sm text-nv-text-secondary">By using NameVerse, you agree to these terms. The site is provided for informational purposes only.</p>
          <p class="text-sm text-nv-text-secondary">Content is provided as-is without warranties. We strive for accuracy but cannot guarantee every meaning or origin is complete or authoritative.</p>
          <p class="text-sm text-nv-text-secondary">For questions, contact us at legal@nameverse.site.</p>
        </div>
      </div>
    </div>
  </main>
</Layout>
