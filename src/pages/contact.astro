---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | NameVerse" description="Get in touch with the NameVerse team.">
  <main class="nv-page min-h-screen">
    <div class="nv-container nv-section">
      <div class="mx-auto max-w-3xl">
        <h1 class="nv-display text-3xl font-bold text-nv-text sm:text-4xl">Contact Us</h1>
        <p class="mt-4 text-nv-text-secondary">Get in touch with the NameVerse team. Coming soon.</p>
        <div class="mt-6 rounded-2xl border border-nv-border bg-white p-6">
          <p class="text-sm text-nv-text-muted">Contact form coming soon. In the meantime, browse <a href="/names" class="text-[color:var(--nv-accent)] underline">baby names</a> or <a href="/about" class="text-[color:var(--nv-accent)] underline">learn more about NameVerse</a>.</p>
        </div>
      </div>
    </div>
  </main>
</Layout>
