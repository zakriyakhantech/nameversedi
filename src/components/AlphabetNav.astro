---
// A–Z alphabet navigation. Props: religion, currentLetter, availableLetters (Set of a-z + '#')
const { religion, currentLetter, availableLetters } = Astro.props;

const letters = [...'abcdefghijklmnopqrstuvwxyz', '#'];
---

<nav aria-label="Browse by letter" class="card flex flex-wrap justify-center gap-1.5 p-4">
  {
    letters.map((l) => {
      const available = availableLetters.has(l);
      const active = currentLetter === l;
      const href = `/names/${religion}/letter/${l === '#' ? '%23' : l}`;
      return available ? (
        <a
          href={href}
          aria-current={active ? 'page' : undefined}
          class:list={[
            'grid h-9 w-9 place-items-center rounded-lg text-sm font-bold uppercase transition',
            active
              ? 'bg-nv-primary text-white shadow-card'
              : 'text-nv-text-secondary hover:bg-nv-accent-subtle hover:text-nv-accent',
          ]}
        >
          {l}
        </a>
      ) : (
        <span class="grid h-9 w-9 cursor-not-allowed place-items-center rounded-lg text-sm font-bold uppercase text-nv-text-muted/50">
          {l}
        </span>
      );
    })
  }
</nav>
